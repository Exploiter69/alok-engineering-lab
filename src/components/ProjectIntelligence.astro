---
interface TimelineItem { title: string; description: string; date: Date; href: string; }
interface RelatedItem { title: string; description: string; href: string; type: string; }
interface ProjectData {
  objective?: string; lifecycle: string; architectureSummary?: string; stack: string[];
  status: string; repository?: string; decisions: string[]; lessons: string[];
}
const { project, relatedItems, timelineItems } = Astro.props as {
  project: { data: ProjectData }; relatedItems: RelatedItem[]; timelineItems: TimelineItem[];
};
const relatedByType = (type: string) => relatedItems.filter(item => item.type === type);
const relatedWriting = relatedByType("Writing");
const relatedNotes = relatedByType("Notes");
const relatedExperiments = relatedByType("Experiments");
---
<section class="mt-14 border-y border-neutral-900 py-10 sm:mt-16" aria-labelledby="project-intelligence-heading">
  <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
    <div><p class="lab-label">Project intelligence</p><h2 id="project-intelligence-heading" class="mt-2 text-2xl font-bold tracking-tight sm:text-3xl">Technical record</h2></div>
    <p class="max-w-sm text-sm leading-6 text-neutral-500">Repository-backed context for understanding what this project is, where it is going and what it has taught.</p>
  </div>
  <div class="mt-10 grid gap-8 md:grid-cols-2">
    {project.data.objective && <div><p class="lab-label">Current objective</p><p class="mt-3 leading-7 text-neutral-300">{project.data.objective}</p></div>}
    <div><p class="lab-label">Lifecycle</p><div class="mt-3 flex flex-wrap gap-2 font-mono text-xs uppercase tracking-[0.12em]"><span class="rounded-full border border-neutral-800 px-2.5 py-1 text-neutral-300">{project.data.lifecycle}</span><span class="rounded-full border border-neutral-800 px-2.5 py-1 text-neutral-500">{project.data.status}</span></div></div>
    {project.data.architectureSummary && <div class="md:col-span-2"><p class="lab-label">Architecture summary</p><p class="mt-3 max-w-3xl leading-7 text-neutral-300">{project.data.architectureSummary}</p></div>}
    <div><p class="lab-label">Technology</p><ul class="mt-3 flex flex-wrap gap-2">{project.data.stack.map(item => <li class="rounded-full border border-neutral-800 px-2.5 py-1 font-mono text-xs text-neutral-400">{item}</li>)}</ul></div>
    {project.data.repository && <div><p class="lab-label">Repository</p><a href={project.data.repository} target="_blank" rel="noopener noreferrer" class="mt-3 inline-flex text-sm text-neutral-300 transition hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white">Open source repository ↗</a></div>}
    {project.data.decisions.length > 0 && <div><p class="lab-label">Important decisions</p><ul class="mt-3 space-y-3 text-sm leading-6 text-neutral-400">{project.data.decisions.map(item => <li class="border-l border-neutral-800 pl-4">{item}</li>)}</ul></div>}
    {project.data.lessons.length > 0 && <div><p class="lab-label">Lessons</p><ul class="mt-3 space-y-3 text-sm leading-6 text-neutral-400">{project.data.lessons.map(item => <li class="border-l border-neutral-800 pl-4">{item}</li>)}</ul></div>}
  </div>
  {(relatedWriting.length || relatedNotes.length || relatedExperiments.length) > 0 && <div class="mt-10 border-t border-neutral-900 pt-8"><p class="lab-label">Knowledge connections</p><div class="mt-4 grid gap-6 sm:grid-cols-3">
    <div><p class="font-mono text-xs uppercase tracking-[0.12em] text-neutral-600">Writing</p>{relatedWriting.length > 0 ? <ul class="mt-3 space-y-2">{relatedWriting.map(item => <li><a href={item.href} class="text-sm text-neutral-400 transition hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white">{item.title} ↗</a></li>)}</ul> : <p class="mt-3 text-sm text-neutral-600">None linked yet.</p>}</div>
    <div><p class="font-mono text-xs uppercase tracking-[0.12em] text-neutral-600">Notes</p>{relatedNotes.length > 0 ? <ul class="mt-3 space-y-2">{relatedNotes.map(item => <li><a href={item.href} class="text-sm text-neutral-400 transition hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white">{item.title} ↗</a></li>)}</ul> : <p class="mt-3 text-sm text-neutral-600">None linked yet.</p>}</div>
    <div><p class="font-mono text-xs uppercase tracking-[0.12em] text-neutral-600">Experiments</p>{relatedExperiments.length > 0 ? <ul class="mt-3 space-y-2">{relatedExperiments.map(item => <li><a href={item.href} class="text-sm text-neutral-400 transition hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white">{item.title} ↗</a></li>)}</ul> : <p class="mt-3 text-sm text-neutral-600">None linked yet.</p>}</div>
  </div></div>}
  {timelineItems.length > 0 && <div class="mt-10 border-t border-neutral-900 pt-8"><p class="lab-label">Project timeline</p><ol class="mt-4 space-y-4">{timelineItems.map(item => <li class="grid gap-1 sm:grid-cols-[130px_1fr] sm:gap-6"><time datetime={item.date.toISOString()} class="font-mono text-xs uppercase tracking-[0.1em] text-neutral-600">{item.date.toDateString()}</time><div><a href={item.href} class="font-medium text-neutral-300 transition hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white">{item.title}</a><p class="mt-1 text-sm leading-6 text-neutral-500">{item.description}</p></div></li>)}</ol></div>}
</section>

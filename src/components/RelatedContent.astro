---
interface RelatedItem {
  title: string;
  description: string;
  href: string;
  type: string;
}

const { items } = Astro.props as { items: RelatedItem[] };
---

{items.length > 0 && (
  <section class="mt-16 border-t border-gray-800 pt-8" aria-labelledby="related-heading">
    <p class="text-xs uppercase tracking-wider text-gray-500">
      Explore further
    </p>

    <h2 id="related-heading" class="mt-2 text-xl font-semibold">
      Related
    </h2>

    <div class="mt-5 grid gap-4 sm:grid-cols-2">
      {items.map(item => (
        <a
          href={item.href}
          class="group rounded-lg border border-gray-800 p-5 transition hover:border-gray-600"
        >
          <p class="text-xs text-gray-500">
            {item.type}
          </p>

          <h3 class="mt-2 font-medium group-hover:text-gray-300">
            {item.title}
          </h3>

          <p class="mt-2 text-sm leading-6 text-gray-400">
            {item.description}
          </p>
        </a>
      ))}
    </div>
  </section>
)}

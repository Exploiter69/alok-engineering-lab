---
interface RelatedItem {
  title: string;
  description: string;
  href: string;
  type: string;
}
const { items } = Astro.props as { items: RelatedItem[] };
---
{items.length > 0 && (
  <section class="mt-16 border-t border-neutral-800 pt-8" aria-labelledby="related-heading">
    <p class="text-xs uppercase tracking-wider text-neutral-500">Explore further</p>
    <h2 id="related-heading" class="mt-2 text-xl font-semibold">Related</h2>
    <div class="mt-5 grid gap-4 sm:grid-cols-2">
      {items.map(item => (
        <a href={item.href} class="group rounded-lg border border-neutral-800 p-5 transition hover:border-neutral-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white">
          <p class="text-xs text-neutral-500">{item.type}</p>
          <h3 class="mt-2 font-medium group-hover:text-neutral-300">{item.title}</h3>
          <p class="mt-2 text-sm leading-6 text-neutral-400">{item.description}</p>
        </a>
      ))}
    </div>
  </section>
)}

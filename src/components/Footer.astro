---
import { SITE } from "../data/site";
---
<footer class="mt-20 border-t border-neutral-800 px-4 py-10 sm:px-6 sm:py-12">
  <div class="mx-auto max-w-6xl">
    <div class="grid gap-10 sm:grid-cols-[1.4fr_1fr] sm:gap-16">
      <div>
        <p class="font-bold tracking-tight text-white">Alok Engineering Lab</p>
        <p class="mt-3 max-w-md text-sm leading-6 text-neutral-500">
          A living record of systems, experiments, technical writing and things learned while building.
        </p>
        <a href={SITE.links.github} target="_blank" rel="noopener noreferrer" class="mt-5 inline-flex min-h-11 items-center text-sm text-neutral-400 transition hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white">
          GitHub ↗
        </a>
      </div>
      <nav class="grid grid-cols-2 gap-x-6 gap-y-3 text-sm" aria-label="Secondary navigation">
        <a href="/garden" class="min-h-11 py-2 text-neutral-400 transition hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white">Lab</a>
        <a href="/contact" class="min-h-11 py-2 text-neutral-400 transition hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white">Contact</a>
        <a href="/changelog" class="min-h-11 py-2 text-neutral-400 transition hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white">Changelog</a>
        <a href="/docs" class="min-h-11 py-2 text-neutral-400 transition hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white">Docs</a>
        <a href="/about" class="min-h-11 py-2 text-neutral-400 transition hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white">About</a>
      </nav>
    </div>
    <div class="mt-10 flex flex-col gap-2 border-t border-neutral-900 pt-5 text-xs text-neutral-600 sm:flex-row sm:items-center sm:justify-between">
      <p>© {new Date().getFullYear()} Alok Engineering Lab</p>
      <p>Static by design · Repository-backed · ₹0 / $0</p>
    </div>
  </div>
</footer>

---
interface Props {
	title: string;
	description: string;
	meta?: string;
	href?: string;
}

const {
	title,
	description,
	meta,
	href
}=Astro.props;
---

{
href ? (
<a 
href={href}
class="
block
border
border-gray-800
rounded-2xl
p-6
hover:border-white
transition
">

<h2 class="text-2xl font-bold">
{title}
</h2>

<p class="mt-3 text-gray-400">
{description}
</p>

{meta && (
<p class="mt-4 text-sm text-gray-500">
{meta}
</p>
)}

</a>
) : (

<div
class="
border
border-gray-800
rounded-2xl
p-6
">

<h2 class="text-2xl font-bold">
{title}
</h2>

<p class="mt-3 text-gray-400">
{description}
</p>

{meta && (
<p class="mt-4 text-sm text-gray-500">
{meta}
</p>
)}

</div>

)
}

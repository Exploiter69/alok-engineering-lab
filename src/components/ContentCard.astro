---
interface Props {
  title: string;
  description: string;
  meta?: string;
  href?: string;
  eyebrow?: string;
  featured?: boolean;
  compact?: boolean;
}

const {
  title,
  description,
  meta,
  href,
  eyebrow,
  featured = false,
  compact = false,
} = Astro.props;
---

{
  href ? (
    <a
      href={href}
      class:list={[
        "group block min-w-0 rounded-2xl border border-neutral-800 transition duration-200 hover:border-neutral-600 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white",
        featured ? "border-neutral-700 bg-neutral-950/40 p-7 sm:p-9 lg:p-10" : compact ? "p-5 sm:px-6" : "p-5 sm:p-6",
      ]}
    >
      {eyebrow && (
        <p class="mb-5 font-mono text-[11px] uppercase tracking-[0.16em] text-neutral-500">
          {eyebrow}
        </p>
      )}

      <div class="flex items-start justify-between gap-6">
        <h3
          class:list={[
            "min-w-0 break-words font-bold tracking-tight text-white",
            featured ? "text-3xl sm:text-4xl" : "text-xl sm:text-2xl",
          ]}
        >
          {title}
        </h3>

        <span
          aria-hidden="true"
          class="shrink-0 text-lg text-neutral-600 transition-transform duration-200 group-hover:translate-x-1 group-hover:text-white"
        >
          →
        </span>
      </div>

      <p class:list={[
        "max-w-2xl break-words leading-7 text-neutral-400",
        featured ? "mt-4 max-w-3xl text-base leading-8 sm:text-lg" : "mt-3",
      ]}>
        {description}
      </p>

      {meta && (
        <p class="mt-5 break-words font-mono text-xs leading-5 text-neutral-500 transition-colors group-hover:text-neutral-400">
          {meta}
        </p>
      )}
    </a>
  ) : (
    <div
      class:list={[
        "min-w-0 rounded-2xl border border-neutral-800",
        featured ? "p-6 sm:p-8" : compact ? "p-5 sm:px-6" : "p-5 sm:p-6",
      ]}
    >
      {eyebrow && (
        <p class="mb-5 font-mono text-[11px] uppercase tracking-[0.16em] text-neutral-500">
          {eyebrow}
        </p>
      )}

      <h3
        class:list={[
          "break-words font-bold tracking-tight",
          featured ? "text-2xl sm:text-3xl" : "text-xl sm:text-2xl",
        ]}
      >
        {title}
      </h3>

      <p class="mt-3 break-words leading-7 text-neutral-400">
        {description}
      </p>

      {meta && (
        <p class="mt-5 break-words font-mono text-xs leading-5 text-neutral-500">
          {meta}
        </p>
      )}
    </div>
  )
}

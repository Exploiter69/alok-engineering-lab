---
interface Props {
  title: string;
  description: string;
  meta?: string;
  href?: string;
}

const {
  title,
  description,
  meta,
  href
} = Astro.props;
---

{
  href ? (
    <a
      href={href}
      class="block min-w-0 rounded-2xl border border-gray-800 p-5 transition hover:border-white sm:p-6"
    >
      <h2 class="break-words text-xl font-bold sm:text-2xl">
        {title}
      </h2>

      <p class="mt-3 break-words text-gray-400">
        {description}
      </p>

      {meta && (
        <p class="mt-4 break-words text-sm text-gray-500">
          {meta}
        </p>
      )}
    </a>
  ) : (
    <div
      class="min-w-0 rounded-2xl border border-gray-800 p-5 sm:p-6"
    >
      <h2 class="break-words text-xl font-bold sm:text-2xl">
        {title}
      </h2>

      <p class="mt-3 break-words text-gray-400">
        {description}
      </p>

      {meta && (
        <p class="mt-4 break-words text-sm text-gray-500">
          {meta}
        </p>
      )}
    </div>
  )
}

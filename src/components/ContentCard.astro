---
interface Props {
  title: string;
  description: string;
  meta?: string;
  status?: string;
  href?: string;
  eyebrow?: string;
  featured?: boolean;
  compact?: boolean;
  headingLevel?: "h2" | "h3";
}

const {
  title,
  description,
  meta,
  status,
  href,
  eyebrow,
  featured = false,
  compact = false,
  headingLevel = "h3",
} = Astro.props;

const statusSymbol = {
  exploring: "○", building: "●", maintaining: "◇", archived: "—",
  benchmark: "◎", failure: "×", verification: "✓", observation: "·",
}[status?.toLowerCase() ?? ""] ?? "·";
const statusClass = ["building", "verification"].includes(status?.toLowerCase() ?? "") ? "text-lime-300" : "text-muted";
---

{
  href ? (
    <a
      href={href}
      class:list={[
        "group block min-w-0 border-b border-lab transition-colors duration-200 motion-reduce:transition-none hover:border-neutral-700 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white",
        featured ? "border-t border-lab-strong py-8 sm:py-10 lg:py-12" : compact ? "py-5 sm:py-6" : "py-6 sm:py-7",
      ]}
    >
      {eyebrow && (
        <p class="mb-5 font-mono text-[11px] uppercase tracking-[0.16em] text-subtle">
          {eyebrow}
        </p>
      )}

      <div class="flex items-start justify-between gap-6">
        {
          headingLevel === "h2" ? (
            <h2
              class:list={[
                "min-w-0 break-words font-bold tracking-tight text-white",
                featured ? "text-3xl sm:text-4xl lg:text-5xl" : "text-xl sm:text-2xl",
              ]}
            >
              {title}
            </h2>
          ) : (
            <h3
              class:list={[
                "min-w-0 break-words font-bold tracking-tight text-white",
                featured ? "text-3xl sm:text-4xl" : "text-xl sm:text-2xl",
              ]}
            >
              {title}
            </h3>
          )
        }

        <span
          aria-hidden="true"
          class="shrink-0 text-lg text-faint transition-transform duration-200 motion-reduce:transition-none group-hover:translate-x-1 group-hover:text-white"
        >
          →
        </span>
      </div>

      <p class:list={[
        "max-w-2xl break-words leading-7 text-muted",
        featured ? "mt-4 max-w-3xl text-base leading-8 sm:text-lg" : "mt-3 text-sm sm:text-base",
      ]}>
        {description}
      </p>

      {(status || meta) && (
        <div class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-2 font-mono text-xs leading-5 text-faint">
          {status && (
            <span class:list={["inline-flex min-h-6 items-center gap-1.5 uppercase tracking-[0.12em]", statusClass]}><span aria-hidden="true">{statusSymbol}</span><span>{status}</span></span>
          )}
          {meta && <span>{meta}</span>}
        </div>
      )}
    </a>
  ) : (
    <div
      class:list={[
        "min-w-0 border-b border-lab",
        featured ? "py-8 sm:py-10" : compact ? "py-5 sm:py-6" : "py-6 sm:py-7",
      ]}
    >
      {eyebrow && (
        <p class="mb-5 font-mono text-[11px] uppercase tracking-[0.16em] text-subtle">
          {eyebrow}
        </p>
      )}

      {
        headingLevel === "h2" ? (
          <h2
            class:list={[
              "break-words font-bold tracking-tight",
              featured ? "text-2xl sm:text-3xl" : "text-xl sm:text-2xl",
            ]}
          >
            {title}
          </h2>
        ) : (
          <h3
            class:list={[
              "break-words font-bold tracking-tight",
              featured ? "text-2xl sm:text-3xl" : "text-xl sm:text-2xl",
            ]}
          >
            {title}
          </h3>
        )
      }

      <p class="mt-3 break-words leading-7 text-muted">
        {description}
      </p>

      {(status || meta) && (
        <div class="mt-5 flex flex-wrap items-center gap-2 font-mono text-xs leading-5 text-subtle">
          {status && (
            <span class:list={["inline-flex min-h-6 items-center gap-1.5 uppercase tracking-[0.12em]", statusClass]}><span aria-hidden="true">{statusSymbol}</span><span>{status}</span></span>
          )}
          {meta && <span>{meta}</span>}
        </div>
      )}
    </div>
  )
}

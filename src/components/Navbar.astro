---
import { getCollection } from "astro:content";
const currentPath = Astro.url.pathname;
const isActive = (href: string) => currentPath === href || currentPath.startsWith(`${href}/`);
const primaryLinks = [
  { href: "/projects", label: "Projects" },
  { href: "/writing", label: "Writing" },
  { href: "/garden", label: "Lab" },
  { href: "/contact", label: "Contact" },
  { href: "/timeline", label: "Journey" },
  { href: "/about", label: "About" },
];
const commandEntries = [
  ...(await getCollection("projects")).filter(item => item.data.status !== "draft").map(item => ({ title: item.data.title, type: "Project", href: "/projects/" + item.id })),
  ...(await getCollection("writing")).filter(item => item.data.status !== "draft").map(item => ({ title: item.data.title, type: "Writing", href: "/writing/" + item.id })),
  ...(await getCollection("notes")).filter(item => item.data.status !== "draft").map(item => ({ title: item.data.title, type: "Note", href: "/notes/" + item.id })),
  ...(await getCollection("experiments")).filter(item => item.data.status !== "draft").map(item => ({ title: item.data.title, type: "Experiment", href: "/experiments/" + item.id })),
  ...(await getCollection("evidence")).filter(item => item.data.status !== "draft").map(item => ({ title: item.data.title, type: "Evidence", href: "/evidence/" + item.id })),
  { title: "Projects", type: "Page", href: "/projects" },
  { title: "Lab", type: "Page", href: "/garden" },
  { title: "Journey", type: "Page", href: "/timeline" },
  { title: "About", type: "Page", href: "/about" },
  { title: "Contact", type: "Page", href: "/contact" },
];
const gardenLinks = [
  { href: "/writing", label: "Writing" },
  { href: "/notes", label: "Notes" },
  { href: "/experiments", label: "Experiments" },
  { href: "/evidence", label: "Evidence" },
];
---

<nav class="sticky top-0 z-50 border-b border-neutral-800 bg-black/95 px-4 py-3 backdrop-blur sm:px-6 sm:py-4" aria-label="Primary navigation">
  <div class="mx-auto max-w-6xl">
    <div class="flex items-center justify-between gap-6">
      <a href="/" class="inline-flex h-11 min-h-11 min-w-0 items-center font-bold tracking-tight text-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white sm:text-lg">
        <span>Alok</span><span class="text-neutral-500"> / Engineering Lab</span>
      </a>

      <div data-nav-desktop class="hidden items-center gap-1 md:flex">
        {primaryLinks.map(link => (
          <a href={link.href} aria-current={isActive(link.href) ? "page" : undefined} class:list={[
            "inline-flex min-h-11 items-center rounded-lg px-3 text-sm transition-colors motion-reduce:transition-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white",
            isActive(link.href) ? "bg-neutral-900 text-white" : "text-neutral-400 hover:bg-neutral-950 hover:text-white"
          ]}>{link.label}</a>
        ))}
        <details class="relative">
          <summary aria-label="Open Lab navigation" class:list={["inline-flex min-h-11 cursor-pointer list-none items-center rounded-lg px-3 text-sm transition-colors hover:bg-neutral-950 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white", gardenLinks.some(link => isActive(link.href)) || isActive("/garden") ? "bg-neutral-900 text-white" : "text-neutral-400"]}>
            Lab +
          </summary>
          <div class="absolute right-0 top-full z-50 mt-2 w-48 rounded-xl border border-neutral-800 bg-black p-2 shadow-2xl">
            {gardenLinks.map(link => (
              <a href={link.href} aria-current={isActive(link.href) ? "page" : undefined} class:list={[
                "flex min-h-11 items-center rounded-lg px-3 text-sm transition-colors hover:bg-neutral-900 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white",
                isActive(link.href) ? "bg-neutral-900 text-white" : "text-neutral-300"
              ]}>{link.label}</a>
            ))}
          </div>
        </details>
        <button type="button" data-command-open class="hidden min-h-11 items-center gap-2 rounded-lg border border-neutral-800 px-3 text-sm text-neutral-500 transition hover:border-neutral-600 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white lg:inline-flex" aria-label="Open command palette">
          <span aria-hidden="true">⌕</span><span>Search</span><kbd class="rounded border border-neutral-800 px-1.5 py-0.5 font-mono text-[10px] text-neutral-600">⌘K</kbd>
        </button>
      </div>

      <details data-nav-mobile class="relative md:hidden">
        <summary class="inline-flex min-h-11 cursor-pointer list-none items-center rounded-lg border border-neutral-800 px-4 text-sm text-neutral-300 hover:border-neutral-600 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white">
          Menu
        </summary>
        <div class="absolute right-0 top-full z-50 mt-2 w-56 rounded-xl border border-neutral-800 bg-black p-2 shadow-2xl">
          {primaryLinks.map(link => (
            <a href={link.href} aria-current={isActive(link.href) ? "page" : undefined} class:list={[
              "flex min-h-11 items-center rounded-lg px-3 text-sm hover:bg-neutral-900 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white",
              isActive(link.href) ? "bg-neutral-900 text-white" : "text-neutral-300"
            ]}>{link.label}</a>
          ))}
          <button type="button" data-command-open class="mt-2 flex min-h-11 w-full items-center justify-between rounded-lg border border-neutral-800 px-3 text-sm text-neutral-400 hover:border-neutral-600 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white" aria-label="Open command palette"><span>Search the Lab</span><kbd class="font-mono text-[10px] text-neutral-600">Ctrl K</kbd></button>
          <div class="my-2 border-t border-neutral-900 pt-2">
            <p class="px-3 py-2 font-mono text-[11px] uppercase tracking-[0.14em] text-neutral-600">Lab</p>
            {gardenLinks.map(link => (
              <a href={link.href} aria-current={isActive(link.href) ? "page" : undefined} class:list={[
                "flex min-h-11 items-center rounded-lg px-3 text-sm hover:bg-neutral-900 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white",
                isActive(link.href) ? "bg-neutral-900 text-white" : "text-neutral-300"
              ]}>{link.label}</a>
            ))}
          </div>
        </div>
      </details>
    </div>
  </div>
</nav>

<dialog id="command-palette" class="fixed left-1/2 top-[12vh] m-0 w-[min(92vw,640px)] -translate-x-1/2 rounded-2xl border border-neutral-800 bg-neutral-950 p-0 text-white shadow-2xl backdrop:bg-black/70 backdrop:backdrop-blur-sm">
  <form method="dialog" class="border-b border-neutral-900 p-3">
    <label class="sr-only" for="command-search">Search the Lab</label>
    <input id="command-search" type="search" autocomplete="off" placeholder="Search projects, writing, notes…" class="min-h-11 w-full bg-transparent px-3 text-base text-white outline-none placeholder:text-neutral-600" />
  </form>
  <div id="command-results" class="max-h-[60vh] overflow-y-auto p-2" role="listbox" aria-label="Search results">
    {commandEntries.map((entry, index) => (
      <a data-command-item href={entry.href} data-search={entry.title.toLowerCase()} class:list={["flex min-h-11 items-center justify-between gap-4 rounded-lg px-3 py-2 text-sm hover:bg-neutral-900 focus-visible:bg-neutral-900 focus-visible:outline-none", index > 8 ? "hidden" : ""]}>
        <span>{entry.title}</span><span class="font-mono text-[10px] uppercase tracking-wider text-neutral-600">{entry.type}</span>
      </a>
    ))}
    <p id="command-empty" class="hidden px-3 py-6 text-sm text-neutral-500">No matching records.</p>
  </div>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>("#command-palette");
  const openers = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-command-open]"));
  const input = document.querySelector<HTMLInputElement>("#command-search");
  const items = Array.from(document.querySelectorAll<HTMLElement>("[data-command-item]"));
  const empty = document.querySelector<HTMLElement>("#command-empty");
  const render = () => {
    const query = input?.value.trim().toLowerCase() ?? "";
    let visible = 0;
    for (const item of items) {
      const matches = !query || (item.dataset.search ?? "").includes(query);
      item.hidden = !matches;
      if (matches) visible += 1;
    }
    empty?.classList.toggle("hidden", visible !== 0);
  };
  const openPalette = () => {
    if (!dialog) return;
    dialog.showModal();
    render();
    requestAnimationFrame(() => input?.focus());
  };
  for (const opener of openers) opener.addEventListener("click", openPalette);
  input?.addEventListener("input", render);
  document.addEventListener("keydown", event => {
    if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k") {
      event.preventDefault();
      if (dialog?.open) dialog.close(); else openPalette();
    }
  });
  const closeMenus = () => {
    for (const menu of document.querySelectorAll("nav details")) menu.open = false;
  };
  document.addEventListener("keydown", event => {
    if (event.key === "Escape") closeMenus();
  });
  document.addEventListener("click", event => {
    const target = event.target;
    if (!(target instanceof Node)) return;
    for (const menu of document.querySelectorAll("nav details")) {
      if (!menu.contains(target)) menu.open = false;
    }
  });
  for (const link of document.querySelectorAll("nav a")) link.addEventListener("click", closeMenus);
</script>

---
const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  currentPath === href || currentPath.startsWith(`${href}/`);
---

<nav class="border-b border-gray-800 px-4 py-4 sm:px-6 sm:py-5" aria-label="Primary navigation">
  <div class="max-w-6xl mx-auto">
    <div class="flex items-center justify-between gap-4">
      <a href="/" class="min-w-0 font-bold text-lg sm:text-xl focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white">Alok Engineering Lab</a>
      <div data-nav-desktop class="hidden md:flex items-center gap-5 text-sm">
        <a href="/projects" aria-current={isActive("/projects") ? "page" : undefined} class:list={["focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white transition", isActive("/projects") ? "text-white" : "text-gray-400 hover:text-white"]}>Projects</a>
        <a href="/garden" aria-current={isActive("/garden") ? "page" : undefined} class:list={["focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white transition", isActive("/garden") ? "text-white" : "text-gray-400 hover:text-white"]}>Garden</a>
        <a href="/writing" aria-current={isActive("/writing") ? "page" : undefined} class:list={["focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white transition", isActive("/writing") ? "text-white" : "text-gray-400 hover:text-white"]}>Writing</a>
        <a href="/notes" aria-current={isActive("/notes") ? "page" : undefined} class:list={["focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white transition", isActive("/notes") ? "text-white" : "text-gray-400 hover:text-white"]}>Notes</a>
        <a href="/evidence" aria-current={isActive("/evidence") ? "page" : undefined} class:list={["focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white transition", isActive("/evidence") ? "text-white" : "text-gray-400 hover:text-white"]}>Evidence</a>
          <a href="/experiments" aria-current={isActive("/experiments") ? "page" : undefined} class:list={["focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white transition", isActive("/experiments") ? "text-white" : "text-gray-400 hover:text-white"]}>Experiments</a>
        <a href="/timeline" aria-current={isActive("/timeline") ? "page" : undefined} class:list={["focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white transition", isActive("/timeline") ? "text-white" : "text-gray-400 hover:text-white"]}>Timeline</a>
      </div>
      <details data-nav-mobile class="relative md:hidden">
        <summary class="cursor-pointer list-none rounded-lg border border-gray-800 px-3 py-2 text-sm text-gray-300 hover:border-gray-600 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white">
          Menu
        </summary>
        <div class="absolute right-0 top-full z-50 mt-2 w-48 rounded-xl border border-gray-800 bg-black p-2 shadow-2xl">
          <a href="/projects" aria-current={isActive("/projects") ? "page" : undefined} class:list={["block rounded-lg px-3 py-2 text-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white hover:bg-gray-900 hover:text-white", isActive("/projects") ? "text-white bg-gray-900" : "text-gray-300"]}>Projects</a>
          <a href="/garden" aria-current={isActive("/garden") ? "page" : undefined} class:list={["block rounded-lg px-3 py-2 text-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white hover:bg-gray-900 hover:text-white", isActive("/garden") ? "text-white bg-gray-900" : "text-gray-300"]}>Garden</a>
          <a href="/writing" aria-current={isActive("/writing") ? "page" : undefined} class:list={["block rounded-lg px-3 py-2 text-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white hover:bg-gray-900 hover:text-white", isActive("/writing") ? "text-white bg-gray-900" : "text-gray-300"]}>Writing</a>
          <a href="/notes" aria-current={isActive("/notes") ? "page" : undefined} class:list={["block rounded-lg px-3 py-2 text-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white hover:bg-gray-900 hover:text-white", isActive("/notes") ? "text-white bg-gray-900" : "text-gray-300"]}>Notes</a>
          <a href="/evidence" aria-current={isActive("/evidence") ? "page" : undefined} class:list={["block rounded-lg px-3 py-2 text-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white hover:bg-gray-900 hover:text-white", isActive("/evidence") ? "text-white bg-gray-900" : "text-gray-300"]}>Evidence</a>
          <a href="/experiments" aria-current={isActive("/experiments") ? "page" : undefined} class:list={["block rounded-lg px-3 py-2 text-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white hover:bg-gray-900 hover:text-white", isActive("/experiments") ? "text-white bg-gray-900" : "text-gray-300"]}>Experiments</a>
          <a href="/timeline" aria-current={isActive("/timeline") ? "page" : undefined} class:list={["block rounded-lg px-3 py-2 text-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white hover:bg-gray-900 hover:text-white", isActive("/timeline") ? "text-white bg-gray-900" : "text-gray-300"]}>Timeline</a>
        </div>
      </details>
    </div>
  </div>
</nav>

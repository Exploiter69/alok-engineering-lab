---
const currentPath = Astro.url.pathname;
const isActive = (href: string) => currentPath === href || currentPath.startsWith(`${href}/`);
const primaryLinks = [
  { href: "/projects", label: "Projects" },
  { href: "/writing", label: "Writing" },
  { href: "/garden", label: "Lab" },
  { href: "/contact", label: "Contact" },
  { href: "/timeline", label: "Journey" },
  { href: "/about", label: "About" },
];
const gardenLinks = [
  { href: "/writing", label: "Writing" },
  { href: "/notes", label: "Notes" },
  { href: "/experiments", label: "Experiments" },
  { href: "/evidence", label: "Evidence" },
];
---

<nav class="border-b border-neutral-800 px-4 py-4 sm:px-6 sm:py-5" aria-label="Primary navigation">
  <div class="mx-auto max-w-6xl">
    <div class="flex items-center justify-between gap-6">
      <a href="/" class="inline-flex h-11 min-h-11 min-w-0 items-center font-bold tracking-tight text-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white sm:text-lg">
        <span>Alok</span><span class="text-neutral-500"> / Engineering Lab</span>
      </a>

      <div data-nav-desktop class="hidden items-center gap-1 md:flex">
        {primaryLinks.map(link => (
          <a href={link.href} aria-current={isActive(link.href) ? "page" : undefined} class:list={[
            "inline-flex min-h-11 items-center rounded-lg px-3 text-sm transition-colors motion-reduce:transition-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white",
            isActive(link.href) ? "bg-neutral-900 text-white" : "text-neutral-400 hover:bg-neutral-950 hover:text-white"
          ]}>{link.label}</a>
        ))}
        <details class="relative">
          <summary aria-label="Open Lab navigation" class:list={["inline-flex min-h-11 cursor-pointer list-none items-center rounded-lg px-3 text-sm transition-colors hover:bg-neutral-950 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white", gardenLinks.some(link => isActive(link.href)) || isActive("/garden") ? "bg-neutral-900 text-white" : "text-neutral-400"]}>
            Lab +
          </summary>
          <div class="absolute right-0 top-full z-50 mt-2 w-48 rounded-xl border border-neutral-800 bg-black p-2 shadow-2xl">
            {gardenLinks.map(link => (
              <a href={link.href} aria-current={isActive(link.href) ? "page" : undefined} class:list={[
                "flex min-h-11 items-center rounded-lg px-3 text-sm transition-colors hover:bg-neutral-900 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white",
                isActive(link.href) ? "bg-neutral-900 text-white" : "text-neutral-300"
              ]}>{link.label}</a>
            ))}
          </div>
        </details>
      </div>

      <details data-nav-mobile class="relative md:hidden">
        <summary class="inline-flex min-h-11 cursor-pointer list-none items-center rounded-lg border border-neutral-800 px-4 text-sm text-neutral-300 hover:border-neutral-600 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white">
          Menu
        </summary>
        <div class="absolute right-0 top-full z-50 mt-2 w-56 rounded-xl border border-neutral-800 bg-black p-2 shadow-2xl">
          {primaryLinks.map(link => (
            <a href={link.href} aria-current={isActive(link.href) ? "page" : undefined} class:list={[
              "flex min-h-11 items-center rounded-lg px-3 text-sm hover:bg-neutral-900 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white",
              isActive(link.href) ? "bg-neutral-900 text-white" : "text-neutral-300"
            ]}>{link.label}</a>
          ))}
          <div class="my-2 border-t border-neutral-900 pt-2">
            <p class="px-3 py-2 font-mono text-[11px] uppercase tracking-[0.14em] text-neutral-600">Lab</p>
            {gardenLinks.map(link => (
              <a href={link.href} aria-current={isActive(link.href) ? "page" : undefined} class:list={[
                "flex min-h-11 items-center rounded-lg px-3 text-sm hover:bg-neutral-900 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white",
                isActive(link.href) ? "bg-neutral-900 text-white" : "text-neutral-300"
              ]}>{link.label}</a>
            ))}
          </div>
        </div>
      </details>
    </div>
  </div>
</nav>

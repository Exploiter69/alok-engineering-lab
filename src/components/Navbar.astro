---
import { NAVIGATION } from "../data/navigation";
import CommandPalette from "./CommandPalette.astro";
const currentPath = Astro.url.pathname;
const isActive = (href: string) => currentPath === href || currentPath.startsWith(`${href}/`);
const primaryLinks = NAVIGATION.primary;
const gardenLinks = NAVIGATION.lab;
---

<nav class="sticky top-0 z-50 border-b border-lab-strong bg-black/95 px-4 py-3 backdrop-blur sm:px-6 sm:py-4" aria-label="Primary navigation">
  <div class="mx-auto max-w-6xl">
    <div class="flex items-center justify-between gap-6">
      <a href="/" class="inline-flex h-11 min-h-11 min-w-0 items-center font-bold tracking-tight text-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white sm:text-lg">
        <span>Alok</span><span class="text-subtle"> / Engineering Lab</span>
      </a>

      <div data-nav-desktop class="hidden items-center gap-1 md:flex">
        {primaryLinks.map(link => (
          <a href={link.href} aria-current={isActive(link.href) ? "page" : undefined} class:list={[
            "inline-flex min-h-11 items-center rounded-lg px-3 text-sm transition-colors motion-reduce:transition-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white",
            isActive(link.href) ? "bg-surface-2 text-white" : "text-muted hover:bg-surface-1 hover:text-white"
          ]}>{link.label}</a>
        ))}
        <details class="relative">
          <summary aria-label="Open Lab navigation" class:list={["inline-flex min-h-11 cursor-pointer list-none items-center rounded-lg px-3 text-sm transition-colors hover:bg-surface-1 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white", gardenLinks.some(link => isActive(link.href)) || isActive("/garden") ? "bg-surface-2 text-white" : "text-muted"]}>
            Lab +
          </summary>
          <div class="nav-menu-panel absolute right-0 top-full z-50 mt-2 w-48 rounded-xl border border-lab-strong bg-black p-2 shadow-2xl">
            {gardenLinks.map(link => (
              <a href={link.href} aria-current={isActive(link.href) ? "page" : undefined} class:list={[
                "flex min-h-11 items-center rounded-lg px-3 text-sm transition-colors hover:bg-surface-2 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white",
                isActive(link.href) ? "bg-surface-2 text-white" : "text-muted"
              ]}>{link.label}</a>
            ))}
          </div>
        </details>
        <button type="button" data-command-open class="hidden min-h-11 items-center gap-2 rounded-lg border border-lab-strong px-3 text-sm text-subtle transition hover:border-neutral-600 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white lg:inline-flex" aria-label="Open command palette">
          <span aria-hidden="true">⌕</span><span>Search</span><kbd class="rounded border border-lab-strong px-1.5 py-0.5 font-mono text-[10px] text-faint">⌘K</kbd>
        </button>
      </div>

      <details data-nav-mobile class="relative md:hidden">
        <summary class="inline-flex min-h-11 cursor-pointer list-none items-center rounded-lg border border-lab-strong px-4 text-sm text-muted hover:border-neutral-600 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white">
          Menu
        </summary>
        <div class="nav-menu-panel absolute right-0 top-full z-50 mt-2 w-56 rounded-xl border border-lab-strong bg-black p-2 shadow-2xl">
          {primaryLinks.map(link => (
            <a href={link.href} aria-current={isActive(link.href) ? "page" : undefined} class:list={[
              "flex min-h-11 items-center rounded-lg px-3 text-sm hover:bg-surface-2 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white",
              isActive(link.href) ? "bg-surface-2 text-white" : "text-muted"
            ]}>{link.label}</a>
          ))}
          <button type="button" data-command-open class="mt-2 flex min-h-11 w-full items-center justify-between rounded-lg border border-lab-strong px-3 text-sm text-muted hover:border-neutral-600 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white" aria-label="Open command palette"><span>Search the Lab</span><kbd class="font-mono text-[10px] text-faint">Ctrl K</kbd></button>
          <div class="my-2 border-t border-lab pt-2">
            <p class="px-3 py-2 font-mono text-[11px] uppercase tracking-[0.14em] text-faint">Lab</p>
            {gardenLinks.map(link => (
              <a href={link.href} aria-current={isActive(link.href) ? "page" : undefined} class:list={[
                "flex min-h-11 items-center rounded-lg px-3 text-sm hover:bg-surface-2 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white",
                isActive(link.href) ? "bg-surface-2 text-white" : "text-muted"
              ]}>{link.label}</a>
            ))}
          </div>
        </div>
      </details>
    </div>
  </div>
</nav>

<CommandPalette />



<script>
  const closeMenus = () => {
    for (const menu of document.querySelectorAll<HTMLDetailsElement>("nav details")) menu.open = false;
  };
  document.addEventListener("keydown", event => {
    if (event.key === "Escape") closeMenus();
  });
  document.addEventListener("click", event => {
    const target = event.target;
    if (!(target instanceof Node)) return;
    for (const menu of document.querySelectorAll<HTMLDetailsElement>("nav details")) {
      if (!menu.contains(target)) menu.open = false;
    }
  });
  for (const link of document.querySelectorAll("nav a")) link.addEventListener("click", closeMenus);
</script>

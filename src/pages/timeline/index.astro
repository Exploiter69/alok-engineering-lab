---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import ContentCard from "../../components/ContentCard.astro";

const timeline = (await getCollection("timeline")).filter(item => item.data.status !== "draft").sort((a,b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout title="Timeline">

<main class="min-h-screen p-10">

<h1 class="text-4xl font-bold">
Timeline
</h1>

<p class="mt-4 text-gray-400">
Engineering journey and milestones.
</p>

<div class="grid gap-6 mt-10">

{
timeline.map(item => (
<ContentCard
title={item.data.title}
description={item.data.description}
meta={item.data.date.toDateString()}
href={`/timeline/${item.id}`}
/>
))
}

</div>

</main>

</Layout>

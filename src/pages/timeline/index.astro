---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import ContentCard from "../../components/ContentCard.astro";

const timeline = (await getCollection("timeline")).filter(item => item.data.status !== "draft").sort((a,b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout title="Timeline">

<main class="min-h-screen max-w-6xl mx-auto px-4 py-12 sm:px-6 sm:py-16 lg:px-10 lg:py-20">

<h1 class="text-3xl font-bold sm:text-4xl">
Timeline
</h1>

<p class="mt-4 text-gray-400">
A chronological record of engineering milestones and turning points.
</p>

<div class="mt-8 grid gap-5 sm:gap-6">

{
timeline.map(item => (
<ContentCard
title={item.data.title}
description={item.data.description}
meta={item.data.date.toDateString()}
headingLevel="h2"
href={`/timeline/${item.id}`}
/>
))
}

</div>

</main>

</Layout>

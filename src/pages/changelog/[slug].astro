---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths(){

const entries = (await getCollection("changelog"))
  .filter(entry => entry.data.status !== "draft");

return entries.map(entry => ({
params:{
slug:entry.id
},
props:{
entry
}
}));

}

const {entry}=Astro.props;
const {Content}=await render(entry);
---

<Layout title={entry.data.title} description={entry.data.description}>

<main class="max-w-3xl mx-auto px-4 py-12 sm:px-6 sm:py-16 lg:py-20">

<a href="/changelog" class="inline-block mb-8 text-sm text-gray-500 hover:text-white transition">
  ← Changelog
</a>

<h1 class="text-3xl font-bold sm:text-5xl">
{entry.data.title}
</h1>

<p class="mt-4 text-gray-400">
{entry.data.description}
</p>

<div class="mt-4 text-sm text-gray-500">
{entry.data.date.toDateString()}
</div>

<article class="prose prose-invert mt-10">
<Content />
</article>

</main>

</Layout>

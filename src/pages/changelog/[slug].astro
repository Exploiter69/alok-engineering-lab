---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const entries = (await getCollection("changelog")).filter(entry => entry.data.status !== "draft");
  return entries.map(entry => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Layout title={entry.data.title} description={entry.data.description}>
<main class="mx-auto max-w-4xl px-4 py-12 sm:px-6 sm:py-16 lg:py-20">
  <a href="/changelog" class="inline-flex items-center gap-2 font-mono text-xs uppercase tracking-[0.14em] text-neutral-500 transition hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"><span aria-hidden="true">←</span>Changelog</a>
  <header class="mt-12 max-w-3xl border-b border-neutral-900 pb-8">
    <p class="lab-label mb-4">Release record</p>
    <h1 class="text-4xl font-bold tracking-tight text-white sm:text-5xl lg:text-6xl">{entry.data.title}</h1>
    <p class="mt-6 max-w-2xl text-lg leading-8 text-neutral-400">{entry.data.description}</p>
    <time datetime={entry.data.date.toISOString()} class="mt-6 block font-mono text-xs uppercase tracking-[0.12em] text-neutral-600">{entry.data.date.toDateString()}</time>
  </header>
  <article class="prose prose-invert mt-12 max-w-3xl sm:mt-16"><Content /></article>
</main>
</Layout>

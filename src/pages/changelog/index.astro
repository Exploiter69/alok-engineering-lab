---
import Layout from "../../layouts/Layout.astro";
import ContentCard from "../../components/ContentCard.astro";
import { getCollection } from "astro:content";

const changelog = (await getCollection("changelog"))
  .filter(item => item.data.status !== "draft")
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout title="Changelog">

<main class="min-h-screen max-w-6xl mx-auto px-4 py-12 sm:px-6 sm:py-16 lg:px-10 lg:py-20">

<h1 class="text-3xl font-bold sm:text-4xl">Changelog</h1>

<p class="mt-4 text-gray-400">
The evolution of Alok Engineering Lab and its releases.
</p>

<div class="mt-8 grid gap-5 sm:gap-6">

{changelog.map(entry => (
<ContentCard
title={entry.data.title}
description={entry.data.description}
meta={entry.data.date.toDateString()}
href={`/changelog/${entry.id}`}
/>
))}

</div>

</main>

</Layout>

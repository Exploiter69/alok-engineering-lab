---
import Layout from "../../layouts/Layout.astro";
import ContentCard from "../../components/ContentCard.astro";
import { getCollection } from "astro:content";

const notes = (await getCollection("notes")).filter(item => item.data.status !== "draft").sort((a,b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout title="Notes">

<main class="min-h-screen p-10">

<h1 class="text-4xl font-bold">
Notes
</h1>

<p class="mt-4 text-gray-400">
Seedlings, budding ideas and evergreen knowledge.
</p>

<div class="grid gap-6 mt-10 md:grid-cols-2">

{
notes.map(note => (
<ContentCard
title={note.data.title}
description={note.data.description}
meta={`${note.data.stage} • ${note.data.tags.join(" • ")}`}
href={`/notes/${note.id}`}
/>
))
}

</div>

</main>

</Layout>

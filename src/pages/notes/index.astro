---
import Layout from "../../layouts/Layout.astro";
import ContentCard from "../../components/ContentCard.astro";
import { getCollection } from "astro:content";

const notes = (await getCollection("notes")).filter(item => item.data.status !== "draft").sort((a,b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout title="Notes">

<main class="min-h-screen max-w-6xl mx-auto px-4 py-12 sm:px-6 sm:py-16 lg:px-10 lg:py-20">

<h1 class="text-3xl font-bold sm:text-4xl">
Notes
</h1>

<p class="mt-4 text-gray-400">
Seedlings, budding ideas and evergreen knowledge.
</p>

<div class="mt-8 grid gap-5 sm:gap-6 md:grid-cols-2">

{
notes.map(note => (
<ContentCard
title={note.data.title}
description={note.data.description}
meta={`${note.data.stage} • ${note.data.tags.join(" • ")}`}
href={`/notes/${note.id}`}
/>
))
}

</div>

</main>

</Layout>

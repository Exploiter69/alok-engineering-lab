---
import Layout from "../../layouts/Layout.astro";
import ContentCard from "../../components/ContentCard.astro";
import { getCollection } from "astro:content";

const notes = (await getCollection("notes"))
  .filter(item => item.data.status !== "draft")
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout title="Notes">

<main class="mx-auto min-h-screen max-w-6xl px-4 py-12 sm:px-6 sm:py-16 lg:py-20">

  <header class="max-w-3xl border-b border-neutral-900 pb-10">
    <p class="lab-label mb-4">03 / Remember</p>
    <h1 class="text-4xl font-bold tracking-tight sm:text-5xl lg:text-6xl">
      Notes
    </h1>
    <p class="mt-5 max-w-2xl text-lg leading-8 text-neutral-400">
      Lightweight engineering knowledge, observations and principles.
    </p>
  </header>

  <section class="mt-10">
    <div class="mb-5 flex items-baseline justify-between gap-4">
      <p class="lab-label">Lab notes</p>
      <span class="font-mono text-xs text-neutral-600">{notes.length} items</span>
    </div>

    <div class="grid gap-4 md:grid-cols-2">
      {
        notes.map((note, index) => (
          <ContentCard
            title={note.data.title}
            description={note.data.description}
            meta={`${note.data.stage} • ${note.data.tags.join(" • ")}`}
            href={`/notes/${note.id}`}
            eyebrow={`NOTE / ${String(index + 1).padStart(2, "0")}`}
            headingLevel="h2"
          />
        ))
      }
    </div>
  </section>

</main>

</Layout>

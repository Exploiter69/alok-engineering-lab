---
import Layout from "../../layouts/Layout.astro";
import RelatedContent from "../../components/RelatedContent.astro";
import KnowledgeProvenance from "../../components/KnowledgeProvenance.astro";
import { resolveRelated } from "../../lib/related";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = (await getCollection("experiments"))
    .filter(entry => entry.data.status !== "draft");

  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const relatedItems = await resolveRelated(post.data.related);
const projectItems = relatedItems.filter(item => item.type === "Projects");
const readingMinutes = Math.max(1, Math.ceil((post.body ?? "").split(/\s+/).filter(Boolean).length / 220));
---

<Layout title={post.data.title} description={post.data.description}>

<main class="mx-auto max-w-4xl px-4 py-12 sm:px-6 sm:py-16 lg:py-20">

  <a
    href="/experiments"
    class="inline-flex items-center gap-2 font-mono text-xs uppercase tracking-[0.14em] text-neutral-500 transition hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
  >
    <span aria-hidden="true">←</span>
    Experiments
  </a>

  <header class="mt-12 max-w-3xl border-b border-neutral-900 pb-10">
    <p class="lab-label">Experiment / Exploration</p>

    <h1 class="mt-5 text-4xl font-bold tracking-tight text-white sm:text-5xl lg:text-6xl">
      {post.data.title}
    </h1>

    <p class="mt-6 max-w-2xl text-lg leading-8 text-neutral-400">
      {post.data.description}
    </p>

    <div class="mt-7 flex flex-wrap gap-x-5 gap-y-2 border-t border-neutral-900 pt-4 font-mono text-xs text-neutral-500">
      <span>{post.data.date.toDateString()}</span><span>{readingMinutes} min read</span>
      <span>{post.data.tags.join(" • ")}</span>
    </div>
  </header>

  <KnowledgeProvenance projectItems={projectItems} />

  <article class="prose prose-invert mt-12 max-w-3xl border-t border-neutral-900 pt-10 sm:mt-16 sm:pt-12">
    <Content />
  </article>

  <RelatedContent items={relatedItems} />

</main>

</Layout>

---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths(){

const posts = (await getCollection("experiments")).filter(entry => entry.data.status !== "draft");

return posts.map(post => ({
params:{
slug:post.id
},
props:{
post
}
}));

}

const {post}=Astro.props;

const {Content}=await render(post);
---

<Layout title={post.data.title} description={post.data.description}>

<main class="max-w-3xl mx-auto px-4 py-12 sm:px-6 sm:py-16 lg:py-20">

<a href="/experiments" class="inline-block mb-8 text-sm text-gray-500 hover:text-white transition">
  ← Experiments
</a>

<h1 class="text-3xl font-bold sm:text-5xl">
{post.data.title}
</h1>

<p class="mt-4 text-gray-400">
{post.data.description}
</p>

<div class="mt-4 text-sm text-gray-500">
{post.data.date.toDateString()}
</div>

<article class="prose prose-invert mt-10">
<Content />
</article>

</main>

</Layout>

---
import Layout from "../../layouts/Layout.astro";
import ContentCard from "../../components/ContentCard.astro";
import { getCollection } from "astro:content";

const experiments = (await getCollection("experiments")).filter(item => item.data.status !== "draft").sort((a,b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout title="Experiments">

<main class="min-h-screen p-10">

<h1 class="text-4xl font-bold">
Experiments
</h1>

<p class="mt-4 text-gray-400">
Small technical explorations and prototypes.
</p>

<div class="grid gap-6 mt-10 md:grid-cols-2">

{
experiments.map(experiment => (
<ContentCard
title={experiment.data.title}
description={experiment.data.description}
meta={experiment.data.tags.join(" • ")}
href={`/experiments/${experiment.id}`}
/>
))
}

</div>

</main>

</Layout>

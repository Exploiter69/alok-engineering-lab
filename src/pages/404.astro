---
import Layout from "../layouts/Layout.astro";

const description = "This page does not exist.";
---

<Layout title="404 — Page Not Found" description={description} noindex>
<main class="mx-auto min-h-screen max-w-6xl px-4 py-12 sm:px-6 sm:py-16 lg:px-10 lg:py-20">
  <header class="max-w-3xl border-b border-neutral-900 pb-10">
    <p class="lab-label mb-4">Error / 404</p>
    <h1 class="text-4xl font-bold tracking-tight sm:text-5xl lg:text-6xl">Page not found.</h1>
    <p class="mt-5 max-w-2xl text-lg leading-8 text-neutral-400">This route does not exist or has moved. The Lab itself is still here.</p>
  </header>
  <section class="mt-10 grid gap-4 sm:grid-cols-2" aria-label="Recovery navigation">
    <a href="/" class="min-h-24 rounded-xl border border-neutral-800 p-5 transition hover:border-neutral-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white">
      <p class="lab-label">01 / Return</p>
      <p class="mt-2 text-lg font-semibold">Engineering Lab</p>
      <p class="mt-1 text-sm text-neutral-500">Go back to the main Lab.</p>
    </a>
    <a href="/projects" class="min-h-24 rounded-xl border border-neutral-800 p-5 transition hover:border-neutral-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white">
      <p class="lab-label">02 / Explore</p>
      <p class="mt-2 text-lg font-semibold">Projects</p>
      <p class="mt-1 text-sm text-neutral-500">Browse the engineering archive.</p>
    </a>
  </section>
</main>
</Layout>

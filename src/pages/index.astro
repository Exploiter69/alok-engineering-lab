---
import Layout from "../layouts/Layout.astro";
import { SITE } from "../data/site";
import { getCollection } from "astro:content";
import ContentCard from "../components/ContentCard.astro";

const projects = (await getCollection("projects"))
  .filter(item => item.data.status !== "draft")
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const writing = (await getCollection("writing"))
  .filter(item => item.data.status !== "draft")
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const notes = (await getCollection("notes"))
  .filter(item => item.data.status !== "draft")
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const experiments = (await getCollection("experiments"))
  .filter(item => item.data.status !== "draft")
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const timeline = (await getCollection("timeline"))
  .filter(item => item.data.status !== "draft")
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout>

<main class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16 lg:py-24">

  <!-- Identity -->
  <section class="max-w-4xl">
    <p class="lab-label mb-6">
      ENGINEERING LAB / DIGITAL GARDEN
    </p>

    <h1 class="text-4xl font-bold leading-[1.05] tracking-tight sm:text-6xl lg:text-7xl">
      Building systems.
      <br />
      Exploring technology.
      <br />
      Documenting the journey.
    </h1>

    <p class="mt-8 max-w-2xl text-lg leading-8 text-neutral-400 sm:text-xl">
      {SITE.tagline}
    </p>

    <div class="mt-8 flex flex-wrap gap-3">
      <a
        href="/projects"
        class="inline-flex items-center rounded-full border border-white bg-white px-5 py-2.5 text-sm font-medium text-black transition hover:bg-neutral-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
      >
        Explore the Lab →
      </a>

      <a
        href="/about"
        class="inline-flex items-center rounded-full border border-neutral-800 px-5 py-2.5 text-sm font-medium text-neutral-300 transition hover:border-neutral-600 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
      >
        About
      </a>
    </div>

    <div class="mt-10 flex flex-wrap gap-x-8 gap-y-3 border-t border-neutral-900 pt-5 text-xs uppercase tracking-[0.16em] text-neutral-500">
      <span><strong class="font-medium text-neutral-300">Status</strong> · Building</span>
      <span><strong class="font-medium text-neutral-300">Focus</strong> · AI / Systems / Automation</span>
    </div>
  </section>


  <!-- Currently -->
  <section class="mt-20 border-y border-neutral-900 py-6 sm:mt-24">
    <div class="grid gap-3 sm:grid-cols-[140px_1fr] sm:gap-8">
      <p class="lab-label">Currently</p>

      <p class="max-w-2xl text-neutral-300">
        {SITE.currently}
      </p>
    </div>
  </section>


  <!-- Selected Work -->
  <section class="mt-20 sm:mt-24">

    <div class="flex items-end justify-between gap-4">
      <div>
        <p class="lab-label mb-2">01 / Build</p>
        <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">
          Selected Work
        </h2>
      </div>

      <a
        href="/projects"
        class="hidden text-sm text-neutral-400 transition hover:text-white sm:block"
      >
        See all →
      </a>
    </div>

    <div class="mt-8">
      {
        projects.slice(0, 1).map(project => (
          <ContentCard
            title={project.data.title}
            description={project.data.description}
            meta={project.data.stack?.join(" • ")}
            href={`/projects/${project.id}`}
            eyebrow="PROJECT / 01"
            featured
          />
        ))
      }
    </div>

    <a
      href="/projects"
      class="mt-5 inline-block text-sm text-neutral-400 transition hover:text-white sm:hidden"
    >
      See all projects →
    </a>

  </section>


  <!-- From the Lab -->
  <section class="mt-20 sm:mt-24">

    <div class="flex items-end justify-between gap-4">
      <div>
        <p class="lab-label mb-2">02 / Explore</p>
        <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">
          From the Lab
        </h2>
      </div>

      <a
        href="/experiments"
        class="hidden text-sm text-neutral-400 transition hover:text-white sm:block"
      >
        See all →
      </a>
    </div>

    <div class="mt-8 grid gap-4 md:grid-cols-2">
      {
        experiments.slice(0, 3).map((item, index) => (
          <ContentCard
            title={item.data.title}
            description={item.data.description}
            meta={item.data.tags.join(" • ")}
            href={`/experiments/${item.id}`}
            eyebrow={`EXPERIMENT / ${String(index + 1).padStart(2, "0")}`}
          />
        ))
      }
    </div>

    <a
      href="/experiments"
      class="mt-5 inline-block text-sm text-neutral-400 transition hover:text-white sm:hidden"
    >
      See all experiments →
    </a>

  </section>


  <!-- Knowledge -->
  <section class="mt-20 sm:mt-24">

    <div>
      <p class="lab-label mb-2">03 / Learn</p>
      <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">
        Knowledge
      </h2>
    </div>

    <div class="mt-10">

      <div class="flex items-baseline justify-between gap-4">
        <p class="lab-label">Writing</p>
        <a href="/writing" class="text-sm text-neutral-400 transition hover:text-white">
          See all →
        </a>
      </div>

      <div class="mt-5 grid gap-4 md:grid-cols-2">
        {
          writing.slice(0, 3).map((item, index) => (
            <ContentCard
              title={item.data.title}
              description={item.data.description}
              meta={item.data.tags.join(" • ")}
              href={`/writing/${item.id}`}
              eyebrow={`WRITING / ${String(index + 1).padStart(2, "0")}`}
            />
          ))
        }
      </div>

    </div>

    <div class="mt-12">

      <div class="flex items-baseline justify-between gap-4">
        <p class="lab-label">Notes</p>
        <a href="/notes" class="text-sm text-neutral-400 transition hover:text-white">
          See all →
        </a>
      </div>

      <div class="mt-5 grid gap-4 md:grid-cols-2">
        {
          notes.slice(0, 3).map((item, index) => (
            <ContentCard
              title={item.data.title}
              description={item.data.description}
              meta={`${item.data.stage} • ${item.data.tags.join(" • ")}`}
              href={`/notes/${item.id}`}
              eyebrow={`NOTE / ${String(index + 1).padStart(2, "0")}`}
            />
          ))
        }
      </div>

    </div>

  </section>


  <!-- Journey -->
  <section class="mt-20 sm:mt-24">

    <div class="flex items-end justify-between gap-4">
      <div>
        <p class="lab-label mb-2">04 / Continue</p>
        <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">
          Journey
        </h2>
      </div>

      <a
        href="/timeline"
        class="hidden text-sm text-neutral-400 transition hover:text-white sm:block"
      >
        See all →
      </a>
    </div>

    <div class="mt-8 grid gap-4">
      {
        timeline.slice(0, 3).map((item, index) => (
          <ContentCard
            title={item.data.title}
            description={item.data.description}
            meta={item.data.date.toDateString()}
            href={`/timeline/${item.id}`}
            eyebrow={`MILESTONE / ${String(index + 1).padStart(2, "0")}`}
            compact
          />
        ))
      }
    </div>

    <a
      href="/timeline"
      class="mt-5 inline-block text-sm text-neutral-400 transition hover:text-white sm:hidden"
    >
      See the full timeline →
    </a>

  </section>

</main>

</Layout>

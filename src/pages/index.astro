---
import Layout from "../layouts/Layout.astro";
import { SITE } from "../data/site";
import { getCollection } from "astro:content";
import ContentCard from "../components/ContentCard.astro";
import ProjectArchitecture from "../components/ProjectArchitecture.astro";

const featuredProjectIds = new Set(["vajra", "astra-userbot", "vgu-signal", "teldrive-lab", "gemini-agent-bridge"]);
const projects = (await getCollection("projects")).filter(item => item.data.status !== "draft").sort((a, b) => {
  const aFeatured = featuredProjectIds.has(a.id);
  const bFeatured = featuredProjectIds.has(b.id);
  if (aFeatured !== bFeatured) return aFeatured ? -1 : 1;
  return b.data.date.valueOf() - a.data.date.valueOf();
});
const writing = (await getCollection("writing")).filter(item => item.data.status !== "draft").sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const notes = (await getCollection("notes")).filter(item => item.data.status !== "draft").sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const experiments = (await getCollection("experiments")).filter(item => item.data.status !== "draft").sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const timeline = (await getCollection("timeline")).filter(item => item.data.status !== "draft").sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const evidence = (await getCollection("evidence")).filter(item => item.data.status !== "draft").sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout>
<main class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16 lg:py-24">

  <section class="hero-surface grid gap-10 border-b border-neutral-900 pb-16 lg:grid-cols-[1.3fr_0.7fr] lg:gap-16 lg:pb-20">
    <div>
      <p class="lab-label mb-6">Alok Thakur / Engineering Lab</p>
      <h1 class="max-w-4xl text-5xl font-bold leading-[0.98] tracking-[-0.04em] sm:text-7xl lg:text-8xl">
        I build reliable<br />automation and AI systems,<br /><span class="text-neutral-500">and document what breaks.</span>
      </h1>
      <p class="mt-8 max-w-2xl text-lg leading-8 text-neutral-300 sm:text-xl">{SITE.tagline} Python · asyncio · Linux · AI agents.</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/projects" class="inline-flex min-h-11 items-center rounded-full border border-white bg-white px-5 py-2.5 text-sm font-medium text-black transition hover:bg-neutral-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white">
          View projects <span aria-hidden="true" class="ml-2">→</span>
        </a>
        <a href="/about" class="inline-flex min-h-11 items-center rounded-full border border-neutral-800 px-5 py-2.5 text-sm font-medium text-neutral-300 transition hover:border-neutral-600 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white">
          How I work
        </a>
      </div>
    </div>

    <aside class="self-end border-t border-neutral-900 pt-6 lg:border-l lg:border-t-0 lg:pl-8">
      <p class="lab-label">What this Lab is</p>
      <p class="mt-3 text-sm leading-7 text-neutral-400">A public engineering record: projects, experiments, technical writing, notes, evidence and the decisions connecting them.</p>
      <dl class="mt-7 space-y-4 border-t border-neutral-900 pt-5 text-sm">
        <div class="flex justify-between gap-4"><dt class="text-neutral-600">Focus</dt><dd class="text-right text-neutral-300">AI · Systems · Automation</dd></div>
        <div class="flex justify-between gap-4"><dt class="text-neutral-600">Model</dt><dd class="text-right text-neutral-300">Static · Repository-backed</dd></div>
        <div class="flex justify-between gap-4"><dt class="text-neutral-600">Status</dt><dd class="text-right text-lime-300"><span aria-hidden="true">●</span> Building</dd></div>
      </dl>
    </aside>
  </section>

  <section class="border-b border-neutral-900 py-7" aria-labelledby="proof-heading">
    <div class="flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
      <div><p class="lab-label mb-2">Proof / Archive</p><h2 id="proof-heading" class="text-2xl font-bold tracking-tight sm:text-3xl">The work is the evidence.</h2></div>
      <a href="/explore" class="inline-flex min-h-11 items-center text-sm text-neutral-400 transition hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white">Search the archive →</a>
    </div>
    <div class="mt-6 grid grid-cols-2 gap-px overflow-hidden border border-neutral-900 bg-neutral-900 sm:grid-cols-4">
      <div class="bg-black p-5"><p class="font-mono text-2xl font-bold text-white">{projects.length}</p><p class="mt-1 text-xs text-neutral-500">engineering projects</p></div>
      <div class="bg-black p-5"><p class="font-mono text-2xl font-bold text-white">{evidence.length}</p><p class="mt-1 text-xs text-neutral-500">evidence records</p></div>
      <div class="bg-black p-5"><p class="font-mono text-2xl font-bold text-white">{writing.length + notes.length}</p><p class="mt-1 text-xs text-neutral-500">published knowledge records</p></div>
      <div class="bg-black p-5"><p class="font-mono text-2xl font-bold text-white">{experiments.length}</p><p class="mt-1 text-xs text-neutral-500">experiments</p></div>
    </div>
  </section>

  <section class="border-b border-neutral-900 py-7 sm:py-8" aria-labelledby="currently-heading">
    <div class="grid gap-3 sm:grid-cols-[140px_1fr] sm:gap-8">
      <p id="currently-heading" class="lab-label">Currently</p>
      <p class="max-w-3xl text-base leading-7 text-neutral-300 sm:text-lg">{SITE.currently}</p>
    </div>
  </section>

  <section class="mt-20 sm:mt-24" aria-labelledby="featured-heading">
    <div class="flex items-end justify-between gap-4 border-b border-neutral-900 pb-5">
      <div><p class="lab-label mb-2">01 / Build</p><h2 id="featured-heading" class="text-3xl font-bold tracking-tight sm:text-4xl">Featured Engineering</h2></div>
      <a href="/projects" class="hidden min-h-11 items-center text-sm text-neutral-400 transition hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white sm:inline-flex">All projects →</a>
    </div>
    <div class="mt-2">
      {projects.slice(0, 3).map((project, index) => (
        <div class="border-b border-lab py-7 sm:py-9">
          <ProjectArchitecture projectId={project.id} title={project.data.title} />
          <ContentCard title={project.data.title} description={project.data.objective ?? project.data.description} status={project.data.lifecycle} meta="" href={`/projects/${project.id}`} eyebrow={`PROJECT / ${String(index + 1).padStart(2, "0")}`} featured={index === 0} headingLevel="h2" />
        </div>
      ))}
    </div>
    <a href="/projects" class="mt-5 inline-flex min-h-11 items-center text-sm text-neutral-400 transition hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white sm:hidden">See all projects →</a>
  </section>

  <section class="mt-20 sm:mt-24" aria-labelledby="lab-heading">
    <div class="flex items-end justify-between gap-4 border-b border-neutral-900 pb-5">
      <div><p class="lab-label mb-2">02 / Explore</p><h2 id="lab-heading" class="text-3xl font-bold tracking-tight sm:text-4xl">The Lab</h2></div>
      <a href="/garden" class="hidden min-h-11 items-center text-sm text-neutral-400 transition hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white sm:inline-flex">Explore Lab →</a>
    </div>
    <div class="mt-2 grid gap-x-8 md:grid-cols-2">
      <div class="border-b border-neutral-900 py-8"><div class="flex items-baseline justify-between gap-4"><p class="lab-label">Experiments</p><span class="font-mono text-xs text-neutral-600">{experiments.length}</span></div><p class="mt-3 max-w-lg text-sm leading-6 text-neutral-500">Tests, prototypes and boundary checks where ideas meet implementation.</p><a href="/experiments" class="mt-4 inline-flex min-h-11 items-center text-sm text-neutral-300 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white">Browse experiments →</a></div>
      <div class="border-b border-neutral-900 py-8"><div class="flex items-baseline justify-between gap-4"><p class="lab-label">Evidence</p><span class="font-mono text-xs text-neutral-600">{evidence.length}</span></div><p class="mt-3 max-w-lg text-sm leading-6 text-neutral-500">Verification, failures, benchmarks and observations supporting engineering claims.</p><a href="/evidence" class="mt-4 inline-flex min-h-11 items-center text-sm text-neutral-300 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white">Inspect evidence →</a></div>
      <div class="border-b border-neutral-900 py-8"><div class="flex items-baseline justify-between gap-4"><p class="lab-label">Knowledge</p><span class="font-mono text-xs text-neutral-600">{writing.length + notes.length}</span></div><p class="mt-3 max-w-lg text-sm leading-6 text-neutral-500">Writing and notes distilled from actual engineering work.</p><a href="/garden" class="mt-4 inline-flex min-h-11 items-center text-sm text-neutral-300 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white">Explore knowledge →</a></div>
      <div class="border-b border-neutral-900 py-8"><div class="flex items-baseline justify-between gap-4"><p class="lab-label">Journey</p><span class="font-mono text-xs text-neutral-600">{timeline.length}</span></div><p class="mt-3 max-w-lg text-sm leading-6 text-neutral-500">Milestones, turning points and durable project history.</p><a href="/timeline" class="mt-4 inline-flex min-h-11 items-center text-sm text-neutral-300 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white">Follow the journey →</a></div>
    </div>
  </section>

  <section class="mt-20 sm:mt-24" aria-labelledby="thinking-heading">
    <div class="flex items-end justify-between gap-4 border-b border-neutral-900 pb-5">
      <div><p class="lab-label mb-2">03 / Think</p><h2 id="thinking-heading" class="text-3xl font-bold tracking-tight sm:text-4xl">Recent Thinking</h2></div>
      <a href="/writing" class="hidden min-h-11 items-center text-sm text-neutral-400 transition hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white sm:inline-flex">All writing →</a>
    </div>
    <div class="mt-2">
      {writing.slice(0, 3).map((item, index) => (
        <ContentCard title={item.data.title} description={item.data.description} meta={item.data.format + " · " + item.data.tags.join(" · ")} href={`/writing/${item.id}`} eyebrow={`WRITING / ${String(index + 1).padStart(2, "0")}`} headingLevel="h2" />
      ))}
    </div>
  </section>

  <section class="mt-20 border-t border-neutral-900 pt-8 sm:mt-24" aria-labelledby="journey-heading">
    <div class="flex items-end justify-between gap-4"><div><p class="lab-label mb-2">04 / Continue</p><h2 id="journey-heading" class="text-3xl font-bold tracking-tight sm:text-4xl">Engineering Journey</h2></div><a href="/timeline" class="hidden min-h-11 items-center text-sm text-neutral-400 transition hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white sm:inline-flex">Full timeline →</a></div>
    <div class="mt-6">
      {timeline.slice(0, 3).map((item, index) => (
        <ContentCard title={item.data.title} description={item.data.description} meta={item.data.date.toDateString()} href={`/timeline/${item.id}`} eyebrow={`MILESTONE / ${String(index + 1).padStart(2, "0")}`} compact />
      ))}
    </div>
  </section>

  <section class="mt-20 border-t border-neutral-900 pt-10 sm:mt-24" aria-labelledby="contact-heading">
    <div class="grid gap-6 sm:grid-cols-[1fr_auto] sm:items-end">
      <div><p class="lab-label mb-2">05 / Connect</p><h2 id="contact-heading" class="text-3xl font-bold tracking-tight sm:text-4xl">Build something worth documenting.</h2><p class="mt-3 max-w-2xl text-base leading-7 text-neutral-400">The Lab is public by design. For collaboration, technical discussion or project feedback, start with GitHub.</p></div>
      <a href={SITE.links.github} rel="me external" target="_blank" class="inline-flex min-h-11 items-center justify-center rounded-full border border-white px-5 py-2.5 text-sm font-medium text-white transition hover:bg-white hover:text-black focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white">GitHub <span aria-hidden="true" class="ml-2">↗</span></a>
    </div>
  </section>

</main>
</Layout>

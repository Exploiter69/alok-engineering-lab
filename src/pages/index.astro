---
import Layout from "../layouts/Layout.astro";
import { SITE } from "../data/site";
import { getCollection } from "astro:content";
import ContentCard from "../components/ContentCard.astro";

const projects = (await getCollection("projects")).filter(item => item.data.status !== "draft").sort((a,b) => b.data.date.valueOf() - a.data.date.valueOf());
const writing = (await getCollection("writing")).filter(item => item.data.status !== "draft").sort((a,b) => b.data.date.valueOf() - a.data.date.valueOf());
const notes = (await getCollection("notes")).filter(item => item.data.status !== "draft").sort((a,b) => b.data.date.valueOf() - a.data.date.valueOf());
const experiments = (await getCollection("experiments")).filter(item => item.data.status !== "draft").sort((a,b) => b.data.date.valueOf() - a.data.date.valueOf());
const timeline = (await getCollection("timeline")).filter(item => item.data.status !== "draft").sort((a,b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout>

<main class="max-w-6xl mx-auto px-4 py-12 sm:px-6 sm:py-16 lg:py-24">


<!-- Identity -->
<section>

<p class="text-neutral-400 mb-6">
Alok Thakur · Engineering Lab
</p>

<h1 class="text-4xl font-bold tracking-tight sm:text-6xl">

Building systems.
<br/>

Exploring technology.
<br/>

Documenting the journey.

</h1>

<p class="mt-8 max-w-xl text-xl text-neutral-400">
{SITE.tagline}
</p>

</section>


<!-- Currently -->
<section class="mt-16">

<p class="text-sm text-gray-500 uppercase tracking-widest mb-3">Currently</p>

<p class="text-gray-300 max-w-xl">
{SITE.currently}
</p>

</section>


<!-- Selected Work -->
<section class="mt-24">

<div class="flex items-baseline justify-between gap-4">
  <h2 class="text-3xl font-bold">Selected Work</h2>
  <a href="/projects" class="text-sm text-gray-500 hover:text-white transition">See all →</a>
</div>

<div class="grid gap-6 mt-8 md:grid-cols-2">

{
projects.slice(0,4).map(project => (
<ContentCard
title={project.data.title}
description={project.data.description}
meta={project.data.stack?.join(" • ")}
href={`/projects/${project.id}`}
/>
))
}

</div>

</section>


<!-- From the Lab -->
<section class="mt-24">

<div class="flex items-baseline justify-between gap-4">
  <h2 class="text-3xl font-bold">From the Lab</h2>
  <a href="/experiments" class="text-sm text-gray-500 hover:text-white transition">See all →</a>
</div>

<div class="grid gap-6 mt-8 md:grid-cols-2">

{
experiments.slice(0,3).map(item => (
<ContentCard
title={item.data.title}
description={item.data.description}
meta={item.data.tags.join(" • ")}
href={`/experiments/${item.id}`}
/>
))
}

</div>

</section>


<!-- Knowledge -->
<section class="mt-24">

<h2 class="text-3xl font-bold">Knowledge</h2>

<div class="mt-10">

  <div class="flex items-baseline justify-between gap-4">
    <p class="text-sm text-gray-500 uppercase tracking-widest">Writing</p>
    <a href="/writing" class="text-sm text-gray-500 hover:text-white transition">See all →</a>
  </div>

  <div class="grid gap-6 mt-5 md:grid-cols-2">

  {
  writing.slice(0,3).map(item => (
  <ContentCard
  title={item.data.title}
  description={item.data.description}
  meta={item.data.tags.join(" • ")}
  href={`/writing/${item.id}`}
  />
  ))
  }

  </div>

</div>

<div class="mt-10">

  <div class="flex items-baseline justify-between gap-4">
    <p class="text-sm text-gray-500 uppercase tracking-widest">Notes</p>
    <a href="/notes" class="text-sm text-gray-500 hover:text-white transition">See all →</a>
  </div>

  <div class="grid gap-6 mt-5 md:grid-cols-2">

  {
  notes.slice(0,3).map(item => (
  <ContentCard
  title={item.data.title}
  description={item.data.description}
  meta={`${item.data.stage} • ${item.data.tags.join(" • ")}`}
  href={`/notes/${item.id}`}
  />
  ))
  }

  </div>

</div>

</section>


<!-- Journey -->
<section class="mt-24">

<div class="flex items-baseline justify-between gap-4">
  <h2 class="text-3xl font-bold">Journey</h2>
  <a href="/timeline" class="text-sm text-gray-500 hover:text-white transition">See all →</a>
</div>

<div class="grid gap-6 mt-8">

{
timeline.slice(0,3).map(item => (
<ContentCard
title={item.data.title}
description={item.data.description}
meta={item.data.date.toDateString()}
href={`/timeline/${item.id}`}
/>
))
}

</div>

</section>


</main>

</Layout>

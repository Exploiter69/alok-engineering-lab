---
import Layout from "../../layouts/Layout.astro";
import ContentCard from "../../components/ContentCard.astro";
import { getCollection } from "astro:content";
import { slugifyTopic } from "../../lib/topics";

const [notes, writing, experiments, evidence] = await Promise.all([
  getCollection("notes"),
  getCollection("writing"),
  getCollection("experiments"),
  getCollection("evidence"),
]);

const gardenItems = [
  ...notes.filter(item => item.data.status !== "draft").map(item => ({ ...item, href: `/notes/${item.id}`, type: "Note" })),
  ...writing.filter(item => item.data.status !== "draft").map(item => ({ ...item, href: `/writing/${item.id}`, type: "Writing" })),
  ...experiments.filter(item => item.data.status !== "draft").map(item => ({ ...item, href: `/experiments/${item.id}`, type: "Experiment" })),
  ...evidence.filter(item => item.data.status !== "draft").map(item => ({ ...item, href: `/evidence/${item.id}`, type: "Evidence" })),
].sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const topics = [...new Set(gardenItems.flatMap(item => item.data.tags))].sort();
const topicSlugs = new Map(topics.map(topic => [topic, slugifyTopic(topic)]));
---

<Layout title="Lab">
<main class="mx-auto min-h-screen max-w-6xl px-4 py-12 sm:px-6 sm:py-16 lg:px-10 lg:py-20">
<header class="max-w-3xl border-b border-neutral-900 pb-10">
<p class="lab-label mb-4">Lab / Explore</p>
<h1 class="text-4xl font-bold tracking-tight sm:text-5xl lg:text-6xl">Lab</h1>
<p class="mt-5 max-w-2xl text-lg leading-8 text-neutral-400">A connected layer for ideas, notes, writing and experiments growing through the Lab.</p>
</header>

<nav class="mt-8 flex flex-wrap items-center gap-2" aria-label="Lab content views">
<span class="mr-2 lab-label">View</span>
<a href="/garden" aria-current="page" class="inline-flex min-h-11 items-center rounded-full border border-neutral-600 px-4 font-mono text-xs uppercase tracking-wider text-white">All</a>
<a href="/notes" class="inline-flex min-h-11 items-center rounded-full border border-neutral-800 px-4 font-mono text-xs uppercase tracking-wider text-neutral-500 hover:border-neutral-600 hover:text-white">Notes</a>
<a href="/writing" class="inline-flex min-h-11 items-center rounded-full border border-neutral-800 px-4 py-2 font-mono text-xs uppercase tracking-wider text-neutral-500 hover:border-neutral-600 hover:text-white">Writing</a>
<a href="/experiments" class="inline-flex min-h-11 items-center rounded-full border border-neutral-800 px-4 py-2 font-mono text-xs uppercase tracking-wider text-neutral-500 hover:border-neutral-600 hover:text-white">Experiments</a>
<a href="/evidence" class="inline-flex min-h-11 items-center rounded-full border border-neutral-800 px-4 py-2 font-mono text-xs uppercase tracking-wider text-neutral-500 hover:border-neutral-600 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white">Evidence</a>
</nav>

<section class="mt-10 border-y border-neutral-900 py-7 sm:py-8" aria-labelledby="search-heading">
<div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
<div>
<p id="search-heading" class="lab-label">Find in the Garden</p>
<p class="mt-2 text-sm text-neutral-500">Search the full text, titles, topics and content types across the published archive.</p>
</div>
<label class="block w-full sm:max-w-sm">
<span class="sr-only">Search the Lab</span>
<input id="garden-search" type="search" placeholder="Search title, topic, or text…" autocomplete="off"
  class="w-full rounded-xl border border-neutral-800 bg-black px-4 py-3 text-sm text-white outline-none placeholder:text-neutral-600 focus:border-neutral-600 focus:ring-1 focus:ring-neutral-600" />
</label>
</div>
<p id="garden-search-status" class="mt-3 font-mono text-xs text-neutral-600" aria-live="polite">{gardenItems.length} items</p>
<p class="mt-4"><a href="/explore" class="inline-flex min-h-11 items-center text-sm text-neutral-300 transition hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white">Search the entire Lab archive →</a></p>
</section>

<section class="mt-12" aria-labelledby="topics-heading">
<div class="mb-5 flex items-baseline justify-between gap-4">
<p id="topics-heading" class="lab-label">Topics</p>
<span class="font-mono text-xs text-neutral-600">{topics.length} topics</span>
</div>
<div class="flex flex-wrap gap-2">
{topics.map(topic => (
<a href={"/garden/topics/" + topicSlugs.get(topic)} class="inline-flex min-h-11 items-center rounded-full border border-neutral-900 px-4 text-xs text-neutral-500 transition hover:border-neutral-600 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white">{topic}</a>
))}
</div>
</section>

<section class="mt-14" aria-labelledby="latest-heading">
<div class="mb-5 flex items-baseline justify-between gap-4">
<p id="latest-heading" class="lab-label">Latest across the Lab</p>
<span class="font-mono text-xs text-neutral-600">{gardenItems.length} items</span>
</div>
<div id="garden-items">
{gardenItems.map(item => (
<article data-garden-item data-search={`${item.data.title} ${item.data.description} ${item.type} ${item.data.tags.join(" ")} ${item.body ?? ""}`.toLowerCase()}>
<ContentCard title={item.data.title} description={item.data.description} meta={`${item.type} • ${item.data.tags.join(" • ")}`} href={item.href} headingLevel="h2" />
</article>
))}
</div>
<p id="garden-empty" class="hidden border border-dashed border-neutral-900 p-6 text-sm text-neutral-500">No published Lab items match that search.</p>
</section>

<section class="mt-14 border-t border-neutral-900 pt-8" aria-labelledby="topic-index-heading">
<p id="topic-index-heading" class="lab-label mb-5">Topic Index</p>
<div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
{topics.map(topic => {
  const slug = topicSlugs.get(topic)!;
  const matches = gardenItems.filter(item => item.data.tags.includes(topic));
  return (
    <a href={"/garden/topics/" + slug} class="block min-h-24 border-b border-neutral-900 py-5 transition hover:border-neutral-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white">
      <p class="font-mono text-xs uppercase tracking-wider text-neutral-500">{topic}</p>
      <p class="mt-2 text-sm text-neutral-400">{matches.length} item{matches.length === 1 ? "" : "s"}</p>
    </a>
  );
})}
</div>
</section>
</main>

<script>
  const input = document.querySelector<HTMLInputElement>("#garden-search");
  const status = document.querySelector<HTMLElement>("#garden-search-status");
  const empty = document.querySelector<HTMLElement>("#garden-empty");
  const items = Array.from(document.querySelectorAll<HTMLElement>("[data-garden-item]"));

  input?.addEventListener("input", () => {
    const query = input.value.trim().toLowerCase();
    let visible = 0;

    for (const item of items) {
      const matches = !query || (item.dataset.search ?? "").includes(query);
      item.hidden = !matches;
      if (matches) visible += 1;
    }

    if (status) {
      status.textContent = query
        ? `${visible} matching item${visible === 1 ? "" : "s"}`
        : `${items.length} items`;
    }

    empty?.classList.toggle("hidden", visible !== 0);
  });
</script>
</Layout>

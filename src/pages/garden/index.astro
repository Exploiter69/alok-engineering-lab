---
import Layout from "../../layouts/Layout.astro";
import ContentCard from "../../components/ContentCard.astro";
---

<Layout title="Digital Garden">

<main class="min-h-screen p-10">

<h1 class="text-4xl font-bold">
Digital Garden
</h1>

<p class="mt-4 text-gray-400">
A growing archive of ideas, experiments and knowledge.
</p>

<div class="grid gap-6 mt-10 md:grid-cols-3">

<ContentCard
title="Notes"
description="Engineering thoughts and principles."
href="/notes"
/>

<ContentCard
title="Writing"
description="Technical essays and discoveries."
href="/writing"
/>

<ContentCard
title="Experiments"
description="Prototypes and technical explorations."
href="/experiments"
/>

</div>

</main>

</Layout>

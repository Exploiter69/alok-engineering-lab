---
import Layout from "../../layouts/Layout.astro";
import ContentCard from "../../components/ContentCard.astro";
import { getCollection } from "astro:content";

const [notes, writing, experiments] = await Promise.all([
  getCollection("notes"),
  getCollection("writing"),
  getCollection("experiments"),
]);

const gardenItems = [
  ...notes
    .filter(item => item.data.status !== "draft")
    .map(item => ({
      ...item,
      href: `/notes/${item.id}`,
      type: "Note",
    })),
  ...writing
    .filter(item => item.data.status !== "draft")
    .map(item => ({
      ...item,
      href: `/writing/${item.id}`,
      type: "Writing",
    })),
  ...experiments
    .filter(item => item.data.status !== "draft")
    .map(item => ({
      ...item,
      href: `/experiments/${item.id}`,
      type: "Experiment",
    })),
].sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout title="Digital Garden">

<main class="min-h-screen max-w-6xl mx-auto px-4 py-12 sm:px-6 sm:py-16 lg:px-10 lg:py-20">

<h1 class="text-3xl font-bold sm:text-4xl">
Digital Garden
</h1>

<p class="mt-4 max-w-2xl text-gray-400">
A connected layer for ideas, notes, writing and experiments growing through the Lab.
</p>

<div class="mt-8 grid gap-5 sm:gap-6 md:grid-cols-2">

{gardenItems.map(item => (
  <ContentCard
    title={item.data.title}
    description={item.data.description}
    meta={`${item.type} • ${item.data.tags.join(" • ")}`}
    href={item.href}
  />
))}

</div>

</main>

</Layout>

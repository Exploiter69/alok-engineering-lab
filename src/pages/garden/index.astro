---
import Layout from "../../layouts/Layout.astro";
import ContentCard from "../../components/ContentCard.astro";
---

<Layout title="Digital Garden">

<main class="min-h-screen max-w-6xl mx-auto px-4 py-12 sm:px-6 sm:py-16 lg:px-10 lg:py-20">

<h1 class="text-3xl font-bold sm:text-4xl">
Digital Garden
</h1>

<p class="mt-4 text-gray-400">
A growing archive of ideas, experiments and knowledge.
</p>

<div class="mt-8 grid gap-5 sm:gap-6 md:grid-cols-3">

<ContentCard
title="Notes"
description="Engineering thoughts and principles."
href="/notes"
/>

<ContentCard
title="Writing"
description="Technical essays and discoveries."
href="/writing"
/>

<ContentCard
title="Experiments"
description="Prototypes and technical explorations."
href="/experiments"
/>

</div>

</main>

</Layout>

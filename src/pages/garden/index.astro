---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { slugifyTopic } from "../../lib/topics";

const [notes, writing, experiments, evidence] = await Promise.all([
  getCollection("notes"),
  getCollection("writing"),
  getCollection("experiments"),
  getCollection("evidence"),
]);

const gardenItems = [
  ...notes.filter(item => item.data.status !== "draft"),
  ...writing.filter(item => item.data.status !== "draft"),
  ...experiments.filter(item => item.data.status !== "draft"),
  ...evidence.filter(item => item.data.status !== "draft"),
].sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const topics = [...new Set(gardenItems.flatMap(item => item.data.tags))].sort();
const topicSlugs = new Map(topics.map(topic => [topic, slugifyTopic(topic)]));
---

<Layout title="Lab" description="A connected layer for notes, writing, experiments and evidence growing through the Engineering Lab.">
<main class="mx-auto min-h-screen max-w-6xl px-4 py-12 sm:px-6 sm:py-16 lg:px-10 lg:py-20">
<header class="max-w-3xl border-b border-neutral-900 pb-10">
<p class="lab-label mb-4">Lab / Explore</p>
<h1 class="text-4xl font-bold tracking-tight sm:text-5xl lg:text-6xl">Lab</h1>
<p class="mt-5 max-w-2xl text-lg leading-8 text-neutral-400">A connected layer for ideas, notes, writing and experiments growing through the Lab.</p>
</header>

<nav class="mt-8 flex flex-wrap items-center gap-2" aria-label="Lab content views">
<span class="mr-2 lab-label">View</span>
<a href="/garden" aria-current="page" class="inline-flex min-h-11 items-center rounded-full border border-neutral-600 px-4 font-mono text-xs uppercase tracking-wider text-white">All</a>
<a href="/notes" class="inline-flex min-h-11 items-center rounded-full border border-neutral-800 px-4 font-mono text-xs uppercase tracking-wider text-neutral-500 hover:border-neutral-600 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white">Notes</a>
<a href="/writing" class="inline-flex min-h-11 items-center rounded-full border border-neutral-800 px-4 font-mono text-xs uppercase tracking-wider text-neutral-500 hover:border-neutral-600 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white">Writing</a>
<a href="/experiments" class="inline-flex min-h-11 items-center rounded-full border border-neutral-800 px-4 font-mono text-xs uppercase tracking-wider text-neutral-500 hover:border-neutral-600 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white">Experiments</a>
<a href="/evidence" class="inline-flex min-h-11 items-center rounded-full border border-neutral-800 px-4 font-mono text-xs uppercase tracking-wider text-neutral-500 hover:border-neutral-600 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white">Evidence</a>
</nav>

<section class="mt-8 border-y border-neutral-900 py-7 sm:py-8" aria-labelledby="garden-search-heading">
<div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
<div>
<p id="garden-search-heading" class="lab-label">Find in the Lab</p>
<p class="mt-2 text-sm text-neutral-500">A lightweight view of the shared archive index. Use Explore for full archive controls.</p>
</div>
<label class="block w-full sm:max-w-sm">
<span class="sr-only">Search the Lab</span>
<input id="garden-search" type="search" placeholder="Search the Lab…" autocomplete="off" class="min-h-11 w-full rounded-xl border border-neutral-800 bg-black px-4 py-3 text-sm text-white outline-none placeholder:text-neutral-600 focus:border-neutral-600 focus:ring-1 focus:ring-neutral-600" />
</label>
</div>
<div class="mt-4 flex flex-wrap gap-2" role="group" aria-label="Filter Lab by type">
{["All", "Writing", "Note", "Experiment", "Evidence"].map((type) => (
<button type="button" data-type={type} aria-pressed={type === "All" ? "true" : "false"} class:list={[
"min-h-11 rounded-full border px-4 font-mono text-xs uppercase tracking-[0.12em] transition focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white",
type === "All" ? "border-neutral-600 bg-neutral-900 text-white" : "border-neutral-900 text-neutral-500 hover:border-neutral-600 hover:text-white"
]}>{type}</button>
))}
</div>
<p id="garden-search-status" class="mt-3 font-mono text-xs text-neutral-600" aria-live="polite">Loading search index…</p>
<p class="mt-4"><a href="/explore" class="inline-flex min-h-11 items-center text-sm text-neutral-300 transition hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white">Search the entire Lab archive →</a></p>
</section>

<section class="mt-12" aria-labelledby="latest-heading">
<div class="mb-5 flex items-baseline justify-between gap-4">
<p id="latest-heading" class="lab-label">Latest across the Lab</p>
<span class="font-mono text-xs text-neutral-600">{gardenItems.length} items</span>
</div>
<div id="garden-items" class="divide-y divide-neutral-900"></div>
<p id="garden-empty" class="hidden border border-dashed border-neutral-900 p-6 text-sm text-neutral-500">No published Lab items match that search.</p>
</section>

<section class="mt-14 border-t border-neutral-900 pt-8" aria-labelledby="topic-index-heading">
<p id="topic-index-heading" class="lab-label mb-5">Topic Index</p>
<div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
{topics.map(topic => {
  const slug = topicSlugs.get(topic)!;
  const matches = gardenItems.filter(item => item.data.tags.includes(topic));
  return (
    <a href={"/garden/topics/" + slug} class="block min-h-24 border-b border-neutral-900 py-5 transition hover:border-neutral-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white">
      <p class="font-mono text-xs uppercase tracking-wider text-neutral-500">{topic}</p>
      <p class="mt-2 text-sm text-neutral-400">{matches.length} item{matches.length === 1 ? "" : "s"}</p>
    </a>
  );
})}
</div>
</section>
</main>

<script>
  type SearchResult = { url: string; meta?: Record<string, string>; plain_excerpt?: string };
  const input = document.querySelector<HTMLInputElement>("#garden-search");
  const status = document.querySelector<HTMLElement>("#garden-search-status");
  const resultsRoot = document.querySelector<HTMLElement>("#garden-items");
  const empty = document.querySelector<HTMLElement>("#garden-empty");
  const typeButtons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-type]"));
  let activeType = "All";
  let pagefindPromise: Promise<any> | undefined;
  let searchGeneration = 0;

  const loadPagefind = async () => {
    if (!pagefindPromise) {
      // @ts-ignore Pagefind generates this static module after Astro check.
      pagefindPromise = import(/* @vite-ignore */ "/pagefind/pagefind.js").then(async (pagefind) => {
        await pagefind.options({ excerptLength: 28, ranking: { metaWeights: { title: 8, tags: 5, description: 3, type: 1 } } });
        await pagefind.init();
        return pagefind;
      });
    }
    return pagefindPromise;
  };

  const renderResults = (results: SearchResult[]) => {
    if (!resultsRoot) return;
    resultsRoot.replaceChildren(...results.map((result) => {
      const article = document.createElement("article");
      article.className = "py-5";
      const link = document.createElement("a");
      link.href = result.url;
      link.className = "block rounded-lg focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white";
      const meta = document.createElement("p");
      meta.className = "font-mono text-[10px] uppercase tracking-[0.12em] text-neutral-600";
      meta.textContent = result.meta?.type ?? "Page";
      const title = document.createElement("h2");
      title.className = "mt-2 text-lg font-semibold text-white";
      title.textContent = result.meta?.title ?? result.url;
      const description = document.createElement("p");
      description.className = "mt-2 max-w-3xl text-sm leading-6 text-neutral-500";
      description.textContent = result.meta?.description ?? result.plain_excerpt ?? "";
      link.append(meta, title, description);
      article.append(link);
      return article;
    }));
    empty?.classList.toggle("hidden", results.length !== 0);
  };

  const search = async () => {
    const generation = ++searchGeneration;
    const pagefind = await loadPagefind();
    if (generation !== searchGeneration) return;
    const query = input?.value.trim() ?? "";
    const filters = activeType === "All" ? { type: { any: ["Writing", "Note", "Experiment", "Evidence"] } } : { type: activeType };
    const result = await pagefind.search(query || null, { filters });
    if (generation !== searchGeneration) return;
    const data = await Promise.all(result.results.slice(0, 40).map((item: { data: () => Promise<SearchResult> }) => item.data()));
    if (generation !== searchGeneration) return;
    renderResults(data);
    if (status) status.textContent = `${data.length} item${data.length === 1 ? "" : "s"}${query ? ` for “${query}”` : ""}`;
  };

  for (const button of typeButtons) {
    button.addEventListener("click", () => {
      activeType = button.dataset.type ?? "All";
      for (const candidate of typeButtons) {
        const active = candidate === button;
        candidate.setAttribute("aria-pressed", String(active));
        candidate.classList.toggle("bg-neutral-900", active);
        candidate.classList.toggle("border-neutral-600", active);
        candidate.classList.toggle("text-white", active);
        candidate.classList.toggle("border-neutral-900", !active);
        candidate.classList.toggle("text-neutral-500", !active);
      }
      void search();
    });
  }

  input?.addEventListener("input", () => void search());
  void search();
</script>
</Layout>

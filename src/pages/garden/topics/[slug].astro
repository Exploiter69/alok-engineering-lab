---
import Layout from "../../../layouts/Layout.astro";
import ContentCard from "../../../components/ContentCard.astro";
import { getCollection } from "astro:content";
import { slugifyTopic } from "../../../lib/topics";

const allItems = [
  ...(await getCollection("notes")).filter(item => item.data.status !== "draft").map(item => ({ ...item, href: "/notes/" + item.id, type: "Note" })),
  ...(await getCollection("writing")).filter(item => item.data.status !== "draft").map(item => ({ ...item, href: "/writing/" + item.id, type: "Writing" })),
  ...(await getCollection("experiments")).filter(item => item.data.status !== "draft").map(item => ({ ...item, href: "/experiments/" + item.id, type: "Experiment" })),
  ...(await getCollection("evidence")).filter(item => item.data.status !== "draft").map(item => ({ ...item, href: "/evidence/" + item.id, type: "Evidence" })),
];

const topics = [...new Set(allItems.flatMap(item => item.data.tags))];
export async function getStaticPaths() {
  const items = [
    ...(await getCollection("notes")).filter(item => item.data.status !== "draft"),
    ...(await getCollection("writing")).filter(item => item.data.status !== "draft"),
    ...(await getCollection("experiments")).filter(item => item.data.status !== "draft"),
    ...(await getCollection("evidence")).filter(item => item.data.status !== "draft"),
  ];
  const topicMap = new Map<string, string>();
  for (const item of items) for (const tag of item.data.tags) topicMap.set(slugifyTopic(tag), tag);
  return [...topicMap.entries()].map(([slug, topic]) => ({ params: { slug }, props: { topic } }));
}

const { topic } = Astro.props as { topic: string };
const items = allItems
  .filter(item => item.data.tags.includes(topic))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout title={"Garden / " + topic} description={"Engineering Lab knowledge tagged " + topic + "."}>
<main class="mx-auto min-h-screen max-w-6xl px-4 py-12 sm:px-6 sm:py-16 lg:px-10 lg:py-20">
  <a href="/garden" class="inline-flex items-center gap-2 font-mono text-xs uppercase tracking-[0.14em] text-neutral-500 transition hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"><span aria-hidden="true">←</span>Garden</a>
  <header class="mt-12 max-w-3xl border-b border-neutral-900 pb-10">
    <p class="lab-label mb-4">Garden / Topic</p>
    <h1 class="text-4xl font-bold tracking-tight sm:text-5xl lg:text-6xl">{topic}</h1>
    <p class="mt-5 max-w-2xl text-lg leading-8 text-neutral-400">{items.length} connected archive item{items.length === 1 ? "" : "s"}.</p>
  </header>
  <section class="mt-10" aria-labelledby="topic-items-heading">
    <div class="mb-5 flex items-baseline justify-between gap-4">
      <p id="topic-items-heading" class="lab-label">Connected knowledge</p>
      <span class="font-mono text-xs text-neutral-600">{topics.length} total topics</span>
    </div>
    <div class="grid gap-4 md:grid-cols-2">
      {items.map((item, index) => (
        <ContentCard title={item.data.title} description={item.data.description} meta={item.type + " • " + item.data.tags.join(" • ")} href={item.href} eyebrow={item.type.toUpperCase() + " / " + String(index + 1).padStart(2, "0")} headingLevel="h2" />
      ))}
    </div>
  </section>
</main>
</Layout>

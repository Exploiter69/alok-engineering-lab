---
import Layout from "../../layouts/Layout.astro";
import RelatedContent from "../../components/RelatedContent.astro";
import ProjectIntelligence from "../../components/ProjectIntelligence.astro";
import ProjectLifecycle from "../../components/ProjectLifecycle.astro";
import ProjectArchitecture from "../../components/ProjectArchitecture.astro";
import TechChips from "../../components/TechChips.astro";
import TableOfContents from "../../components/TableOfContents.astro";
import { resolveRelated } from "../../lib/related";
import { getCollection, render } from "astro:content";
export async function getStaticPaths() {
  const projects = (await getCollection("projects")).filter(entry => entry.data.status !== "draft");
  return projects.map(project => ({ params: { slug: project.id }, props: { project } }));
}
const { project } = Astro.props;
const { Content } = await render(project);
const relatedItems = await resolveRelated(project.data.related);
const timelineItems = (await getCollection("timeline"))
  .filter(item => item.data.status !== "draft" && item.data.related.includes(`projects:${project.id}`))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .map(item => ({ title: item.data.title, description: item.data.description, date: item.data.date, href: `/timeline/${item.id}` }));
---
<Layout title={project.data.title} description={project.data.description} searchType="Project" searchTags={project.data.tags}>
<main class="mx-auto max-w-4xl px-4 py-12 sm:px-6 sm:py-16 lg:py-20">
  <a href="/projects" class="inline-flex items-center gap-2 font-mono text-xs uppercase tracking-[0.14em] text-neutral-500 transition hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"><span aria-hidden="true">←</span>Projects</a>
  <header class="mt-12 max-w-3xl border-b border-neutral-900 pb-10">
    <p class="lab-label">Project / Engineering Case Study</p>
    <h1 class="mt-5 text-4xl font-bold tracking-tight text-white sm:text-5xl lg:text-6xl">{project.data.title}</h1>
    <p class="mt-6 max-w-2xl text-lg leading-8 text-neutral-400">{project.data.description}</p>
    <div class="mt-7 border-t border-neutral-900 pt-4">
      <div class="flex flex-wrap gap-2 font-mono text-xs uppercase tracking-[0.12em] text-neutral-500"><span>Documented {project.data.date.toDateString()}</span><span class="rounded-full border border-neutral-800 px-2.5 py-1">{project.data.status}</span><span class="rounded-full border border-neutral-800 px-2.5 py-1">{project.data.lifecycle}</span></div>
      <div class="mt-4"><TechChips stack={project.data.stack} /></div>
      {project.data.repository && <a href={project.data.repository} target="_blank" rel="noopener noreferrer" class="mt-4 inline-flex text-sm text-neutral-400 transition hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white">GitHub ↗</a>}
    </div>
  </header>
  <section class="mt-10 grid gap-4 border-b border-neutral-900 pb-10 sm:grid-cols-3" aria-label="Case study navigation"><a href="#technical-record" class="min-h-11 border border-neutral-900 p-4 transition hover:border-neutral-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"><span class="lab-label">01</span><span class="mt-2 block text-sm font-medium text-neutral-300">Technical record</span></a><a href="#project-history" class="min-h-11 border border-neutral-900 p-4 transition hover:border-neutral-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"><span class="lab-label">02</span><span class="mt-2 block text-sm font-medium text-neutral-300">History & evidence</span></a><a href="#case-study" class="min-h-11 border border-neutral-900 p-4 transition hover:border-neutral-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"><span class="lab-label">03</span><span class="mt-2 block text-sm font-medium text-neutral-300">Case study</span></a></section>
  <div class="mt-10"><ProjectArchitecture projectId={project.id} title={project.data.title} architectureSummary={project.data.architectureSummary} decisions={project.data.decisions} /></div>
  <div id="technical-record" class="mt-10"><ProjectIntelligence project={project} relatedItems={relatedItems} timelineItems={timelineItems} /></div>
  <div id="project-history"><ProjectLifecycle project={project} /></div>
  <div class="mt-12 grid gap-10 lg:grid-cols-[minmax(0,1fr)_220px] sm:mt-16">
    <article id="case-study" class="prose prose-invert max-w-3xl border-t border-neutral-900 pt-10 sm:pt-12"><Content /></article>
    <TableOfContents source={project.body} extra={[{ title: "Technical record", id: "technical-record" }, { title: "History & evidence", id: "project-history" }, { title: "Case study", id: "case-study" }]} />
  </div>
  <RelatedContent items={relatedItems} />
</main>
</Layout>

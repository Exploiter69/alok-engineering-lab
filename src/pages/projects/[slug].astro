---
import Layout from "../../layouts/Layout.astro";
import RelatedContent from "../../components/RelatedContent.astro";
import { resolveRelated } from "../../lib/related";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const projects = (await getCollection("projects"))
    .filter(entry => entry.data.status !== "draft");

  return projects.map(project => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const relatedItems = await resolveRelated(project.data.related);
---

<Layout title={project.data.title} description={project.data.description}>

<main class="mx-auto max-w-4xl px-4 py-12 sm:px-6 sm:py-16 lg:py-20">

  <a
    href="/projects"
    class="inline-flex items-center gap-2 font-mono text-xs uppercase tracking-[0.14em] text-neutral-500 transition hover:text-white"
  >
    <span aria-hidden="true">←</span>
    Projects
  </a>

  <header class="mt-12 max-w-3xl">
    <p class="lab-label">Project / Engineering Work</p>

    <h1 class="mt-5 text-4xl font-bold tracking-tight text-white sm:text-5xl lg:text-6xl">
      {project.data.title}
    </h1>

    <p class="mt-6 max-w-2xl text-lg leading-8 text-neutral-400">
      {project.data.description}
    </p>

    <div class="mt-7 flex flex-wrap gap-x-5 gap-y-2 border-y border-neutral-900 py-4 font-mono text-xs text-neutral-500">
      <span>{project.data.date.toDateString()}</span>
      {project.data.stack?.length > 0 && (
        <span>{project.data.stack.join(" • ")}</span>
      )}
    </div>
  </header>

  <article class="prose prose-invert mt-12 max-w-3xl sm:mt-16">
    <Content />
  </article>

  <RelatedContent items={relatedItems} />

</main>

</Layout>

---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths(){

const projects = (await getCollection("projects")).filter(entry => entry.data.status !== "draft");

return projects.map(project => ({
params:{
slug:project.id
},
props:{
project
}
}));

}


const {project}=Astro.props;

const { Content } = await render(project);

---

<Layout title={project.data.title} description={project.data.description}>

<main class="max-w-3xl mx-auto px-4 py-12 sm:px-6 sm:py-16 lg:py-20">

<a href="/projects" class="inline-block mb-8 text-sm text-gray-500 hover:text-white transition">
  ← Projects
</a>

<h1 class="text-3xl font-bold sm:text-5xl">
{project.data.title}
</h1>

<p class="mt-4 text-gray-400">
{project.data.description}
</p>

<div class="mt-4 text-sm text-gray-500">
{project.data.date.toDateString()}
</div>

<article class="prose prose-invert mt-10">
<Content />
</article>

</main>

</Layout>

---
import Layout from "../../layouts/Layout.astro";
import ContentCard from "../../components/ContentCard.astro";
import { getCollection } from "astro:content";

const featuredProjectIds = new Set([
  "vajra",
  "astra-userbot",
  "vgu-signal",
  "teldrive-lab",
  "gemini-agent-bridge",
]);

const projects = (await getCollection("projects"))
  .filter(item => item.data.status !== "draft")
  .sort((a, b) => {
    const aFeatured = featuredProjectIds.has(a.id);
    const bFeatured = featuredProjectIds.has(b.id);

    if (aFeatured !== bFeatured) return aFeatured ? -1 : 1;
    return b.data.date.valueOf() - a.data.date.valueOf();
  });
---

<Layout title="Projects">

<main class="mx-auto min-h-screen max-w-6xl px-4 py-12 sm:px-6 sm:py-16 lg:py-20">

  <header class="max-w-3xl border-b border-neutral-900 pb-10">
    <p class="lab-label mb-4">01 / Build</p>
    <h1 class="text-4xl font-bold tracking-tight sm:text-5xl lg:text-6xl">
      Projects
    </h1>
    <p class="mt-5 max-w-2xl text-lg leading-8 text-neutral-400">
      Substantial systems, tools and engineering work.
    </p>
  </header>

  <nav class="mt-8 flex flex-wrap gap-2" aria-label="Project lifecycle filters">
    {["all", "exploring", "building", "maintaining", "archived"].map(state => <button type="button" data-project-filter={state} aria-pressed={state === "all"} class="rounded-full border border-neutral-800 px-4 py-2 font-mono text-xs uppercase tracking-wider text-neutral-500 hover:border-neutral-600 hover:text-white">{state}</button>)}
  </nav>

  <label class="mt-5 block max-w-xl"><span class="sr-only">Search projects</span><input id="project-search" type="search" placeholder="Search projects, technology, lifecycle…" autocomplete="off" class="w-full rounded-xl border border-neutral-800 bg-black px-4 py-3 text-sm text-white outline-none placeholder:text-neutral-600 focus:border-neutral-600 focus:ring-1 focus:ring-neutral-600" /></label>
  <p id="project-filter-status" class="mt-3 font-mono text-xs text-neutral-600" aria-live="polite">{projects.length} projects</p>

  <section class="mt-8 border-y border-neutral-900 py-6" aria-labelledby="archive-overview-heading">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="lab-label">Archive overview</p>
        <h2 id="archive-overview-heading" class="mt-2 text-xl font-bold tracking-tight sm:text-2xl">Project history at a glance</h2>
      </div>
      <p class="max-w-md text-sm leading-6 text-neutral-500">Lifecycle is historical engineering context, while publication status controls what is publicly rendered.</p>
    </div>
    <div class="mt-5 grid grid-cols-2 gap-3 sm:grid-cols-4">
      {["exploring", "building", "maintaining", "archived"].map(state => {
        const count = projects.filter(project => project.data.lifecycle === state).length;
        return (
          <button type="button" data-project-filter={state} class="rounded-xl border border-neutral-900 p-4 text-left transition hover:border-neutral-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white" aria-label={`Show ${count} ${state} projects`} aria-pressed="false">
            <span class="font-mono text-[11px] uppercase tracking-[0.14em] text-neutral-600">{state}</span>
            <span class="mt-2 block text-2xl font-bold text-neutral-200">{count}</span>
          </button>
        );
      })}
    </div>
  </section>

  <section class="mt-8">
    <div class="mb-5 flex items-baseline justify-between gap-4">
      <p class="lab-label">Engineering work</p>
      <span class="font-mono text-xs text-neutral-600">{projects.length} items</span>
    </div>

    <div class="grid gap-4 md:grid-cols-2">
      {
        projects.map((project, index) => (
          <article data-project-item data-lifecycle={project.data.lifecycle} data-search={(project.data.title + " " + project.data.description + " " + project.data.lifecycle + " " + project.data.stack.join(" ")).toLowerCase()}>
          <ContentCard
            title={project.data.title}
            description={project.data.description}
            status={project.data.lifecycle}
            meta={project.data.stack?.join(" • ")}
            href={`/projects/${project.id}`}
            eyebrow={`PROJECT / ${String(index + 1).padStart(2, "0")}`}
            featured={index === 0}
            headingLevel="h2"
          />
          </article>
        ))
      }
    </div>
  </section>

</main>

<script>
  const search = document.querySelector<HTMLInputElement>("#project-search");
  const status = document.querySelector<HTMLElement>("#project-filter-status");
  const items = Array.from(document.querySelectorAll<HTMLElement>("[data-project-item]"));
  const filters = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-project-filter]"));
  let activeFilter = "all";
  const render = () => {
    const query = search?.value.trim().toLowerCase() ?? "";
    let visible = 0;
    for (const item of items) {
      const lifecycle = item.dataset.lifecycle ?? "";
      const haystack = item.dataset.search ?? "";
      const matches = (activeFilter === "all" || lifecycle === activeFilter) && (!query || haystack.includes(query));
      item.hidden = !matches;
      if (matches) visible += 1;
    }
    if (status) status.textContent = query || activeFilter !== "all" ? `${visible} matching project${visible === 1 ? "" : "s"}` : `${items.length} projects`;
  };
  for (const item of items) item.dataset.search = `${item.textContent ?? ""}`.toLowerCase();
  search?.addEventListener("input", render);
  for (const button of filters) button.addEventListener("click", () => {
    activeFilter = button.dataset.projectFilter ?? "all";
    for (const filter of filters) filter.setAttribute("aria-pressed", String(filter === button));
    render();
  });
</script>

</Layout>

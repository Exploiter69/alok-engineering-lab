---
import Layout from "../../layouts/Layout.astro";
import ContentCard from "../../components/ContentCard.astro";
import { getCollection } from "astro:content";

const featuredProjectIds = new Set(["vajra", "astra-userbot", "vgu-signal", "teldrive-lab", "gemini-agent-bridge"]);
const projects = (await getCollection("projects")).filter(item => item.data.status !== "draft").sort((a, b) => {
  const aFeatured = featuredProjectIds.has(a.id);
  const bFeatured = featuredProjectIds.has(b.id);
  if (aFeatured !== bFeatured) return aFeatured ? -1 : 1;
  return b.data.date.valueOf() - a.data.date.valueOf();
});
const technologies = [...new Set(projects.flatMap(project => project.data.stack))].sort();
const counts = ["exploring", "building", "maintaining", "archived"].map(state => ({
  state,
  count: projects.filter(project => project.data.lifecycle === state).length,
}));
---

<Layout title="Projects">
<main class="mx-auto min-h-screen max-w-6xl px-4 py-12 sm:px-6 sm:py-16 lg:py-20">
  <header class="max-w-3xl border-b border-neutral-900 pb-10">
    <p class="lab-label mb-4">01 / Build</p>
    <h1 class="text-4xl font-bold tracking-tight sm:text-5xl lg:text-6xl">Projects</h1>
    <p class="mt-5 max-w-2xl text-lg leading-8 text-neutral-400">Systems, tools and engineering work — with the reasoning, evidence and history behind them.</p>
  </header>

  <section class="mt-8 border-y border-neutral-900 py-6" aria-labelledby="archive-overview-heading">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <div><p class="lab-label">Archive overview</p><h2 id="archive-overview-heading" class="mt-2 text-xl font-bold tracking-tight sm:text-2xl">Engineering lifecycle</h2></div>
      <p class="max-w-md text-sm leading-6 text-neutral-500">Lifecycle records describe historical engineering state. Publication status controls what is rendered.</p>
    </div>
    <div class="mt-5 grid grid-cols-2 gap-px overflow-hidden border border-neutral-900 bg-neutral-900 sm:grid-cols-4">
      {counts.map(({state, count}) => (
        <button type="button" data-project-filter={state} aria-pressed="false" class="min-h-20 border-r border-b border-transparent bg-black p-4 text-left transition-colors hover:bg-neutral-950 focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-white">
          <span class="font-mono text-[11px] uppercase tracking-[0.14em] text-neutral-600">{state}</span>
          <span class="mt-1 block text-2xl font-bold text-neutral-200">{count}</span>
        </button>
      ))}
    </div>
  </section>

  <section class="mt-8" aria-labelledby="project-search-heading">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <div><p id="project-search-heading" class="lab-label">Find a project</p><p class="mt-2 text-sm text-neutral-500">Search names, technology and lifecycle without leaving the page.</p></div>
      <label class="block w-full sm:max-w-sm"><span class="sr-only">Search projects</span><input id="project-search" type="search" placeholder="Search projects…" autocomplete="off" class="min-h-11 w-full rounded-xl border border-neutral-800 bg-black px-4 text-sm text-white outline-none placeholder:text-neutral-600 focus:border-neutral-600 focus:ring-1 focus:ring-neutral-600" /></label>
    </div>
    <div class="mt-4 flex flex-wrap gap-2" role="group" aria-label="Project lifecycle filters">
      <button type="button" data-project-filter="all" aria-pressed="true" class="min-h-11 rounded-full border border-neutral-600 bg-neutral-900 px-4 font-mono text-xs uppercase tracking-wider text-white">All</button>
      {counts.map(({state}) => <button type="button" data-project-filter={state} aria-pressed="false" class="min-h-11 rounded-full border border-neutral-800 px-4 font-mono text-xs uppercase tracking-wider text-neutral-500 hover:border-neutral-600 hover:bg-neutral-950 hover:text-white">{state}</button>)}
    </div>
    <div class="mt-5 border-t border-neutral-900 pt-5" aria-label="Project technology filters">
      <p class="lab-label mb-3">Technology</p>
      <div class="flex flex-wrap gap-2">
        <button type="button" data-project-tech="all" aria-pressed="true" class="min-h-11 rounded-full border border-neutral-600 bg-neutral-900 px-4 font-mono text-xs uppercase tracking-wider text-white">All</button>
        {technologies.slice(0, 12).map(tech => <button type="button" data-project-tech={tech} aria-pressed="false" class="min-h-11 rounded-full border border-neutral-800 px-4 font-mono text-xs uppercase tracking-wider text-neutral-500 hover:border-neutral-600 hover:bg-neutral-950 hover:text-white">{tech}</button>)}
      </div>
    </div>
    <p id="project-filter-status" class="mt-3 font-mono text-xs text-neutral-600" aria-live="polite">{projects.length} projects</p>
  </section>

  <section class="mt-10" aria-labelledby="engineering-work-heading">
    <div class="mb-2 flex items-baseline justify-between gap-4"><p id="engineering-work-heading" class="lab-label">Engineering work</p><span class="font-mono text-xs text-neutral-600">{projects.length} records</span></div>
    <div>
      {projects.map((project, index) => (
        <article data-project-item data-lifecycle={project.data.lifecycle} data-stack={project.data.stack.join("|")} data-search={(project.data.title + " " + project.data.description + " " + project.data.lifecycle + " " + project.data.stack.join(" ") + " " + (project.data.architectureSummary ?? "") + " " + project.data.decisions.join(" ") + " " + project.data.lessons.join(" ")).toLowerCase()}>
          <ContentCard title={project.data.title} description={project.data.description} status={project.data.lifecycle} meta={project.data.stack.join(" · ")} href={`/projects/${project.id}`} eyebrow={`PROJECT / ${String(index + 1).padStart(2, "0")}`} featured={index === 0} headingLevel="h2" />
        </article>
      ))}
    </div>
    <p id="project-empty" class="hidden border-b border-neutral-900 py-8 text-sm text-neutral-500">No projects match the current filter.</p>
  </section>
</main>

<script>
  const search = document.querySelector<HTMLInputElement>("#project-search");
  const status = document.querySelector<HTMLElement>("#project-filter-status");
  const empty = document.querySelector<HTMLElement>("#project-empty");
  const items = Array.from(document.querySelectorAll<HTMLElement>("[data-project-item]"));
  const filters = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-project-filter]"));
  const techFilters = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-project-tech]"));
  let activeFilter = "all";
  let activeTech = "all";

  const render = () => {
    const query = search?.value.trim().toLowerCase() ?? "";
    let visible = 0;
    for (const item of items) {
      const lifecycle = item.dataset.lifecycle ?? "";
      const haystack = item.dataset.search ?? "";
      const stack = item.dataset.stack?.split("|") ?? [];
      const matches = (activeFilter === "all" || lifecycle === activeFilter) && (activeTech === "all" || stack.includes(activeTech)) && (!query || haystack.includes(query));
      item.hidden = !matches;
      if (matches) visible += 1;
    }
    if (status) status.textContent = query || activeFilter !== "all" || activeTech !== "all" ? `${visible} matching project${visible === 1 ? "" : "s"}` : `${items.length} projects`;
    empty?.classList.toggle("hidden", visible !== 0);
  };

  search?.addEventListener("input", render);
  for (const button of filters) button.addEventListener("click", () => {
    activeFilter = button.dataset.projectFilter ?? "all";
    for (const filter of filters) { const active = filter === button; filter.setAttribute("aria-pressed", String(active)); filter.classList.toggle("bg-neutral-900", active); filter.classList.toggle("border-neutral-600", active); filter.classList.toggle("text-white", active); filter.classList.toggle("text-neutral-300", active); filter.classList.toggle("border-neutral-800", !active); filter.classList.toggle("text-neutral-500", !active); filter.classList.toggle("bg-black", !active); }
    render();
  });
  for (const button of techFilters) button.addEventListener("click", () => {
    activeTech = button.dataset.projectTech ?? "all";
    for (const filter of techFilters) { const active = filter === button; filter.setAttribute("aria-pressed", String(active)); filter.classList.toggle("bg-neutral-900", active); filter.classList.toggle("border-neutral-600", active); filter.classList.toggle("text-white", active); filter.classList.toggle("text-neutral-500", !active); filter.classList.toggle("border-neutral-800", !active); }
    render();
  });
</script>
</Layout>

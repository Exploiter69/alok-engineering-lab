---
import Layout from "../../layouts/Layout.astro";
import ContentCard from "../../components/ContentCard.astro";
import { getCollection } from "astro:content";

const projects = (await getCollection("projects")).filter(item => item.data.status !== "draft").sort((a,b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout title="Projects">

<main class="min-h-screen p-10">

<h1 class="text-4xl font-bold">
Projects
</h1>

<p class="mt-4 text-gray-400">
Engineering systems, experiments and shipped work.
</p>


<div class="grid gap-6 mt-10 md:grid-cols-2">

{
projects.map(project => (

<ContentCard
title={project.data.title}
description={project.data.description}
meta={project.data.stack?.join(" • ")}
href={`/projects/${project.id}`}
/>

))
}

</div>

</main>

</Layout>

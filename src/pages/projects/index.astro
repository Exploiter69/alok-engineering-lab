---
import Layout from "../../layouts/Layout.astro";
import ContentCard from "../../components/ContentCard.astro";
import { getCollection } from "astro:content";

const projects = (await getCollection("projects")).filter(item => item.data.status !== "draft").sort((a,b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout title="Projects">

<main class="min-h-screen max-w-6xl mx-auto px-4 py-12 sm:px-6 sm:py-16 lg:px-10 lg:py-20">

<h1 class="text-3xl font-bold sm:text-4xl">
Projects
</h1>

<p class="mt-4 text-gray-400">
Substantial systems, tools and engineering work.
</p>


<div class="mt-8 grid gap-5 sm:gap-6 md:grid-cols-2">

{
projects.map(project => (

<ContentCard
title={project.data.title}
description={project.data.description}
meta={project.data.stack?.join(" • ")}
href={`/projects/${project.id}`}
/>

))
}

</div>

</main>

</Layout>

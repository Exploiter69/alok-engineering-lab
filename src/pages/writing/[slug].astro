---
import Layout from "../../layouts/Layout.astro";
import RelatedContent from "../../components/RelatedContent.astro";
import { resolveRelated } from "../../lib/related";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = (await getCollection("writing"))
    .filter(entry => entry.data.status !== "draft");

  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const relatedItems = await resolveRelated(post.data.related);
---

<Layout title={post.data.title} description={post.data.description}>

<main class="mx-auto max-w-4xl px-4 py-12 sm:px-6 sm:py-16 lg:py-20">

  <a
    href="/writing"
    class="inline-flex items-center gap-2 font-mono text-xs uppercase tracking-[0.14em] text-neutral-500 transition hover:text-white"
  >
    <span aria-hidden="true">←</span>
    Writing
  </a>

  <header class="mt-12 max-w-3xl">
    <p class="lab-label">Writing / Technical Essay</p>

    <h1 class="mt-5 text-4xl font-bold tracking-tight text-white sm:text-5xl lg:text-6xl">
      {post.data.title}
    </h1>

    <p class="mt-6 max-w-2xl text-lg leading-8 text-neutral-400">
      {post.data.description}
    </p>

    <div class="mt-7 flex flex-wrap gap-x-5 gap-y-2 border-y border-neutral-900 py-4 font-mono text-xs text-neutral-500">
      <span>{post.data.date.toDateString()}</span>
      <span>{post.data.tags.join(" • ")}</span>
    </div>
  </header>

  <article class="prose prose-invert mt-12 max-w-3xl sm:mt-16">
    <Content />
  </article>

  <RelatedContent items={relatedItems} />

</main>

</Layout>

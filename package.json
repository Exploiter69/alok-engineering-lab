{
  "name": "alok-engineering-lab",
  "type": "module",
  "version": "1.0.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "npm run validate && astro check && astro build",
    "audit": "node scripts/visual-audit.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "dev:clean": "./scripts/dev.sh",
    "stop-dev": "npx astro dev stop",
    "clean-dev": "./scripts/clean-dev.sh",
    "start": "npm run clean-dev && npm run dev",
    "validate": "npm run validate:metadata && npm run validate:links && npm run validate:lifecycle && npm run validate:writing",
    "validate:metadata": "node scripts/validate-content-metadata.mjs",
    "validate:links": "node scripts/validate-content-links.mjs",
    "validate:lifecycle": "node scripts/validate-project-lifecycle.mjs",
    "validate:writing": "node scripts/validate-writing.mjs",
    "audit:performance": "node scripts/performance-audit.mjs",
    "new:content": "node scripts/new-content.mjs",
    "check": "npm run validate && astro check && astro build && npm run audit"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.8",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.9",
    "tailwindcss": "^4.3.3"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/typography": "^0.5.20",
    "typescript": "^6.0.3"
  }
}
